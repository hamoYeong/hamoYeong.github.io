---
import BaseLayout from '../layouts/BaseLayout.astro';
import posts from '../data/posts.json';
---

<BaseLayout title="Posts | Hamo" description="Hamo의 글과 기록을 모아두는 페이지입니다.">
	<section class="page-intro">
		<h1>Posts</h1>
		<p>
			글, 기록, 회고처럼 텍스트 중심 콘텐츠를 모아둡니다. 지금 항목은 이번
			수업을 위한 기본 구조이며, 나중에 글 성격에 맞게 바꿀 수 있습니다.
		</p>
	</section>

	<section class="post-list" aria-label="Post list">
		{
			posts.map((post) => (
				<article class="post-item">
					<div class="post-meta">
						<time datetime={post.date}>{post.date}</time>
					</div>
					<h2>{post.title}</h2>
					<p>{post.summary}</p>
					<ul aria-label={`${post.title} tags`}>
						{post.tags.map((tag) => (
							<li>{tag}</li>
						))}
					</ul>
				</article>
			))
		}
	</section>
</BaseLayout>

<style>
	.post-list {
		margin-top: clamp(3rem, 7vw, 5rem);
	}

	.post-item {
		border-top: 1px solid #e6e8eb;
		padding: 1.75rem 0;
	}

	.post-meta {
		display: flex;
		flex-wrap: wrap;
		gap: 0.5rem 0.75rem;
		color: #686f78;
		font-size: 0.9rem;
	}

	h2 {
		margin: 0.85rem 0 0;
		color: #202124;
		font-size: 1.35rem;
		line-height: 1.4;
		word-break: keep-all;
	}

	.post-item p {
		max-width: 46rem;
		margin: 0.85rem 0 0;
		color: #4b535c;
		line-height: 1.75;
		word-break: keep-all;
	}

	ul {
		display: flex;
		flex-wrap: wrap;
		gap: 0.5rem;
		margin: 1rem 0 0;
		padding: 0;
		list-style: none;
	}

	li {
		border: 1px solid #d9dde2;
		border-radius: 999px;
		padding: 0.35rem 0.7rem;
		color: #2f363d;
		font-size: 0.9rem;
	}
</style>
