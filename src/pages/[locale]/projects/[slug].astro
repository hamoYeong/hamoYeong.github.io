---
import { render, type CollectionEntry } from 'astro:content';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Callout from '../../../components/Callout.astro';
import ExternalLink from '../../../components/ExternalLink.astro';
import {
	locales,
	localizedPath,
	type LocalePaths,
} from '../../../i18n/config';
import { getUi } from '../../../i18n/ui';
import {
	findTranslation,
	getProjects,
} from '../../../lib/content';

interface Props {
	project: CollectionEntry<'projects'>;
}

export async function getStaticPaths() {
	const projects = await getProjects();

	return projects.map((project) => ({
		params: {
			locale: project.data.locale,
			slug: project.data.slug,
		},
		props: { project },
	}));
}

const { project } = Astro.props;
const locale = project.data.locale;
const t = getUi(locale);
const { Content } = await render(project);
const allProjects = await getProjects();
const alternatePaths = Object.fromEntries(
	locales.map((targetLocale) => {
		const translation = findTranslation(
			allProjects,
			project.data.translationKey,
			targetLocale,
		);
		const path = translation
			? localizedPath(targetLocale, `projects/${translation.data.slug}`)
			: localizedPath(targetLocale, 'projects');

		return [targetLocale, path];
	}),
) as LocalePaths;
---

<BaseLayout
	locale={locale}
	title={`${project.data.title} | Hamo`}
	description={project.data.summary}
	alternatePaths={alternatePaths}
>
	<div class="article-shell">
		<a class="back-link" href={localizedPath(locale, 'projects')}>← {t.projects.back}</a>

		<article>
		<header class="article-header">
			<p class="eyebrow">{t.projects.eyebrow}</p>
			<h1>{project.data.title}</h1>
			<p class="article-summary">{project.data.summary}</p>
		</header>

		<dl class="project-meta">
			<div>
				<dt>{t.projects.period}</dt>
				<dd>{project.data.period.label}</dd>
			</div>
			<div>
				<dt>{t.projects.role}</dt>
				<dd>{project.data.role.join(', ')}</dd>
			</div>
		</dl>

		<Callout title={t.projects.team}>
			<p>{project.data.team.description}</p>
		</Callout>

		{
			(project.data.repository || project.data.demo) && (
				<div class="external-links">
					{project.data.repository && (
						<ExternalLink href={project.data.repository}>
							{t.projects.repository}
						</ExternalLink>
					)}
					{project.data.demo && (
						<ExternalLink href={project.data.demo}>{t.projects.demo}</ExternalLink>
					)}
				</div>
			)
		}

		<div class="fact-grid">
			<section>
				<h2>{t.projects.problem}</h2>
				<p>{project.data.problem}</p>
			</section>
			<section>
				<h2>{t.projects.contributions}</h2>
				<ul>
					{project.data.contributions.map((item) => <li>{item}</li>)}
				</ul>
			</section>
			<section>
				<h2>{t.projects.outcomes}</h2>
				<ul>
					{project.data.outcomes.map((item) => <li>{item}</li>)}
				</ul>
			</section>
			<section>
				<h2>{t.projects.learnings}</h2>
				<ul>
					{project.data.learnings.map((item) => <li>{item}</li>)}
				</ul>
			</section>
		</div>

		<div class="article-content">
			<Content />
		</div>
	</article>
	</div>
</BaseLayout>

<style>
	.project-meta {
		display: grid;
		gap: var(--space-4);
		margin: var(--space-10) 0 0;
		border-block: var(--border-default);
		padding: var(--space-6) 0;
	}

	.project-meta div {
		display: grid;
		grid-template-columns: 6rem 1fr;
		gap: var(--space-4);
	}

	dt {
		font-size: var(--text-sm);
		font-weight: 850;
	}

	dd {
		margin: 0;
		color: var(--color-text-soft);
		line-height: var(--leading-body);
	}

	.external-links {
		display: flex;
		flex-wrap: wrap;
		gap: var(--space-3);
		margin-top: var(--space-6);
	}

	.fact-grid {
		display: grid;
		gap: var(--space-8);
		margin-top: var(--space-12);
	}

	.fact-grid section {
		border-left: 3px solid var(--color-border);
		padding-left: var(--space-5);
	}

	.fact-grid h2 {
		margin: 0;
		font-size: 1.15rem;
	}

	.fact-grid p,
	.fact-grid li {
		color: var(--color-text-soft);
		line-height: var(--leading-body);
	}

	.fact-grid p {
		margin-bottom: 0;
	}

	@media (max-width: 640px) {
		.project-meta div {
			grid-template-columns: 1fr;
			gap: var(--space-1);
		}
	}
</style>
