---
import type { CollectionEntry } from 'astro:content';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Callout from '../../../components/Callout.astro';
import ExternalLink from '../../../components/ExternalLink.astro';
import PostCard from '../../../components/PostCard.astro';
import Tag from '../../../components/Tag.astro';
import {
	formatDate,
	locales,
	localizedPath,
	type LocalePaths,
} from '../../../i18n/config';
import { getUi } from '../../../i18n/ui';
import {
	findTranslation,
	getPosts,
	getProjects,
} from '../../../lib/content';

interface Props {
	project: CollectionEntry<'projects'>;
}

export async function getStaticPaths() {
	const projects = await getProjects();

	return projects.map((project) => ({
		params: {
			locale: project.data.locale,
			slug: project.data.slug,
		},
		props: { project },
	}));
}

const { project } = Astro.props;
const locale = project.data.locale;
const t = getUi(locale);
const [allProjects, posts] = await Promise.all([
	getProjects(),
	getPosts({ locale }),
]);
const relatedPosts = posts.filter((post) =>
	project.data.relatedPosts.includes(post.data.translationKey),
);
const alternatePaths = Object.fromEntries(
	locales.map((targetLocale) => {
		const translation = findTranslation(
			allProjects,
			project.data.translationKey,
			targetLocale,
		);
		const path = translation
			? localizedPath(targetLocale, `projects/${translation.data.slug}`)
			: localizedPath(targetLocale, 'projects');

		return [targetLocale, path];
	}),
) as LocalePaths;
const contents = [
	{ id: 'overview', label: t.projects.overview },
	{ id: 'problem', label: t.projects.problem },
	{ id: 'context', label: t.projects.context },
	{ id: 'role', label: t.projects.myRole },
	{ id: 'process', label: t.projects.process },
	{ id: 'decisions', label: t.projects.keyDecisions },
	{ id: 'structure', label: t.projects.technicalStructure },
	{ id: 'challenges', label: t.projects.challenges },
	{ id: 'outcome', label: t.projects.outcomes },
	{ id: 'change', label: t.projects.whatIWouldChange },
	{ id: 'learning', label: t.projects.learnings },
];
---

<BaseLayout
	locale={locale}
	title={`${project.data.title} | Hamo`}
	description={project.data.summary}
	alternatePaths={alternatePaths}
>
	<div class="case-shell">
		<a class="back-link" href={localizedPath(locale, 'projects')}>
			← {t.projects.back}
		</a>

		<article>
			<header class="case-hero">
				<div class="case-hero__content">
					<div class="case-hero__eyebrow">
						<p class="eyebrow">{t.projects.eyebrow}</p>
						<span>{t.projects.statusLabels[project.data.status]}</span>
					</div>
					<h1>{project.data.title}</h1>
					<p class="case-hero__summary">{project.data.summary}</p>
					<div class="case-hero__tags">
						{
							project.data.categories.map((category) => (
								<Tag label={category} />
							))
						}
					</div>
				</div>
				<div
					class:list={[
						'case-hero__visual',
						{ 'case-hero__visual--image': project.data.coverImage },
					]}
					aria-hidden={project.data.coverImage ? undefined : 'true'}
				>
					{
						project.data.coverImage ? (
							<img
								src={project.data.coverImage.src}
								alt={project.data.coverImage.alt}
							/>
						) : (
							<>
								<span>{project.data.title.trim().slice(0, 1).toUpperCase()}</span>
								<p>{project.data.technologies.slice(0, 3).join(' · ')}</p>
							</>
						)
					}
				</div>
			</header>

			<dl class="project-meta">
				<div>
					<dt>{t.projects.period}</dt>
					<dd>{project.data.period.label}</dd>
				</div>
				<div>
					<dt>{t.projects.role}</dt>
					<dd>{project.data.role.join(', ')}</dd>
				</div>
				<div>
					<dt>{t.projects.technologies}</dt>
					<dd>{project.data.technologies.join(', ')}</dd>
				</div>
			</dl>

			<div class="external-links">
				{
					project.data.repository && (
						<ExternalLink href={project.data.repository}>
							{t.projects.repository}
						</ExternalLink>
					)
				}
				{
					project.data.demo && (
						<ExternalLink href={project.data.demo}>
							{t.projects.demo}
						</ExternalLink>
					)
				}
			</div>

			{
				project.data.artifacts.length > 0 && (
					<section class="artifact-showcase" aria-labelledby="artifact-showcase-title">
						<div class="artifact-showcase__heading">
							<p class="eyebrow">{t.projects.artifactEyebrow}</p>
							<h2 id="artifact-showcase-title">{t.projects.artifactTitle}</h2>
						</div>
						<div class="artifact-list">
							{project.data.artifacts.map((artifact) => (
								<article class="artifact-card">
									<a
										class="artifact-card__preview"
										href={artifact.href}
										target="_blank"
										rel="noreferrer"
									>
										<img
											src={artifact.previewImage.src}
											alt={artifact.previewImage.alt}
											loading="lazy"
										/>
									</a>
									<div class="artifact-card__content">
										<div>
											<h3>{artifact.title}</h3>
											<p>{artifact.description}</p>
										</div>
										<div class="artifact-card__actions">
											<a href={artifact.href} target="_blank" rel="noreferrer">
												{t.projects.openArtifact} <span aria-hidden="true">↗</span>
											</a>
											<a href={artifact.href} download>
												{t.projects.downloadArtifact} <span aria-hidden="true">↓</span>
											</a>
										</div>
									</div>
								</article>
							))}
						</div>
					</section>
				)
			}

			<nav class="case-contents" aria-label={t.projects.contents}>
				<p>{t.projects.contents}</p>
				<ol>
					{
						contents.map((item, index) => (
							<li>
								<a href={`#${item.id}`}>
									<span>{String(index + 1).padStart(2, '0')}</span>
									{item.label}
								</a>
							</li>
						))
					}
				</ol>
			</nav>

			<div class="case-study">
				<section id="overview" class="case-section case-section--lead">
					<p class="case-section__index">01</p>
					<div>
						<h2>{t.projects.overview}</h2>
						<p class="lead-copy">{project.data.overview}</p>
					</div>
				</section>

				<section id="problem" class="case-section">
					<p class="case-section__index">02</p>
					<div>
						<h2>{t.projects.problem}</h2>
						<div class="two-column">
							<div>
								<h3>{t.projects.problem}</h3>
								<p>{project.data.problem}</p>
							</div>
							<div>
								<h3>{t.projects.whyItMattered}</h3>
								<p>{project.data.whyItMattered}</p>
							</div>
						</div>
					</div>
				</section>

				<section id="context" class="case-section">
					<p class="case-section__index">03</p>
					<div>
						<h2>{t.projects.context}</h2>
						<div class="two-column">
							<div>
								<h3>{t.projects.context}</h3>
								<p>{project.data.context}</p>
							</div>
							<div>
								<h3>{t.projects.user}</h3>
								<p>{project.data.user}</p>
							</div>
						</div>
						{
							project.data.research.length > 0 && (
								<div class="research">
									<h3>{t.projects.research}</h3>
									<ul>
										{project.data.research.map((item) => <li>{item}</li>)}
									</ul>
								</div>
							)
						}
					</div>
				</section>

				<section id="role" class="case-section">
					<p class="case-section__index">04</p>
					<div>
						<h2>{t.projects.myRole}</h2>
						<Callout title={t.projects.team}>
							<p>{project.data.team.description}</p>
						</Callout>
						<div class="two-column">
							<div>
								<h3>{t.projects.role}</h3>
								<ul>
									{project.data.role.map((item) => <li>{item}</li>)}
								</ul>
							</div>
							<div>
								<h3>{t.projects.contributions}</h3>
								<ul>
									{project.data.contributions.map((item) => <li>{item}</li>)}
								</ul>
							</div>
						</div>
					</div>
				</section>

				<section id="process" class="case-section">
					<p class="case-section__index">05</p>
					<div>
						<h2>{t.projects.process}</h2>
						{
							project.data.processDetails.length > 0 ? (
								<ol class="process-timeline">
									{project.data.processDetails.map((step, index) => (
										<li>
											<span class="process-timeline__index">
												{String(index + 1).padStart(2, '0')}
											</span>
											<div>
												<p class="process-timeline__title">{step.title}</p>
												<h3>{step.question}</h3>
												<ul>
													{step.items.map((item) => <li>{item}</li>)}
												</ul>
											</div>
										</li>
									))}
								</ol>
							) : (
								<ol class="process-list">
									{project.data.process.map((item, index) => (
										<li>
											<span>{String(index + 1).padStart(2, '0')}</span>
											<p>{item}</p>
										</li>
									))}
								</ol>
							)
						}
						{
							project.data.processSummary && (
								<Callout title={t.projects.processTakeaway}>
									<p>{project.data.processSummary}</p>
								</Callout>
							)
						}
					</div>
				</section>

				<section id="decisions" class="case-section">
					<p class="case-section__index">06</p>
					<div>
						<h2>{t.projects.keyDecisions}</h2>
						{
							project.data.questionShift && (
								<div class="question-shift">
									<div class="question-shift__heading">
										<p class="question-shift__eyebrow">{t.projects.primaryQuestion}</p>
										<h3>{project.data.questionShift.summary}</h3>
									</div>
									<div class="question-shift__comparison">
										<article class="question-shift__state">
											<p class="question-shift__label">{t.projects.before}</p>
											<strong>{project.data.questionShift.before.statement}</strong>
											<p>{project.data.questionShift.before.note}</p>
										</article>
										<span class="question-shift__arrow" aria-hidden="true">→</span>
										<article class="question-shift__state question-shift__state--after">
											<p class="question-shift__label">{t.projects.after}</p>
											<strong>{project.data.questionShift.after.statement}</strong>
											<p>{project.data.questionShift.after.note}</p>
										</article>
									</div>
									{project.data.questionShift.secondary.length > 0 && (
										<div class="secondary-shifts">
											{project.data.questionShift.secondary.map((shift) => (
												<article class="secondary-shift">
													<p class="secondary-shift__label">{shift.label}</p>
													<div class="secondary-shift__flow">
														<strong>{shift.before}</strong>
														<span aria-hidden="true">→</span>
														<strong>{shift.after}</strong>
													</div>
													<p>{shift.note}</p>
												</article>
											))}
										</div>
									)}
								</div>
							)
						}
						<div class="decision-grid">
							{
								project.data.keyDecisions.map((decision) => (
									<article>
										<h3>{decision.title}</h3>
										<p>{decision.description}</p>
									</article>
								))
							}
						</div>
					</div>
				</section>

				<section id="structure" class="case-section">
					<p class="case-section__index">07</p>
					<div>
						<h2>{t.projects.technicalStructure}</h2>
						<ul class="structure-list">
							{
								project.data.technicalStructure.map((item) => (
									<li>{item}</li>
								))
							}
						</ul>
						<div class="technology-list">
							{
								project.data.technologies.map((technology) => (
									<Tag label={technology} />
								))
							}
						</div>
					</div>
				</section>

				<section id="challenges" class="case-section">
					<p class="case-section__index">08</p>
					<div>
						<h2>{t.projects.challenges}</h2>
						<ul>
							{project.data.challenges.map((item) => <li>{item}</li>)}
						</ul>
					</div>
				</section>

				<section id="outcome" class="case-section">
					<p class="case-section__index">09</p>
					<div>
						<h2>{t.projects.outcomes}</h2>
						<ul class="outcome-list">
							{project.data.outcomes.map((item) => <li>{item}</li>)}
						</ul>
					</div>
				</section>

				<section id="change" class="case-section">
					<p class="case-section__index">10</p>
					<div>
						<h2>{t.projects.whatIWouldChange}</h2>
						<ul>
							{project.data.whatIWouldChange.map((item) => <li>{item}</li>)}
						</ul>
					</div>
				</section>

				<section id="learning" class="case-section">
					<p class="case-section__index">11</p>
					<div>
						<h2>{t.projects.learnings}</h2>
						<ul class="learning-list">
							{project.data.learnings.map((item) => <li>{item}</li>)}
						</ul>
					</div>
				</section>
			</div>

			{
				relatedPosts.length > 0 && (
					<section class="related-posts" aria-labelledby="related-posts-title">
						<h2 id="related-posts-title">{t.projects.relatedPosts}</h2>
						<div class="related-posts__list">
							{relatedPosts.map((post) => (
								<PostCard
									title={post.data.title}
									description={post.data.description}
									date={formatDate(post.data.publishedAt, locale)}
									tags={post.data.tags}
									href={localizedPath(locale, `posts/${post.data.slug}`)}
									actionLabel={t.posts.readMore}
								/>
							))}
						</div>
					</section>
				)
			}
		</article>
	</div>
</BaseLayout>

<style>
	.case-shell {
		max-width: var(--width-wide);
		margin-inline: auto;
	}

	.case-hero {
		display: grid;
		margin-top: var(--space-8);
		grid-template-columns: minmax(0, 1.4fr) minmax(15rem, 0.6fr);
		gap: clamp(var(--space-8), 7vw, var(--space-16));
		align-items: stretch;
	}

	.case-hero__content {
		padding-block: var(--space-8);
	}

	.case-hero__eyebrow {
		display: flex;
		align-items: center;
		gap: var(--space-3);
	}

	.case-hero__eyebrow p {
		margin: 0;
	}

	.case-hero__eyebrow span {
		border: var(--border-default);
		border-radius: var(--radius-pill);
		padding: var(--space-1) var(--space-3);
		color: var(--color-text-faint);
		font-size: var(--text-xs);
		font-weight: 850;
	}

	.case-hero h1 {
		max-width: 15ch;
		margin: var(--space-5) 0 0;
		font-size: var(--text-display);
		line-height: var(--leading-tight);
		letter-spacing: -0.045em;
		word-break: keep-all;
	}

	.case-hero__summary {
		max-width: 48rem;
		margin: var(--space-6) 0 0;
		color: var(--color-text-soft);
		font-size: var(--text-md);
		line-height: var(--leading-body);
	}

	.case-hero__tags,
	.technology-list {
		display: flex;
		flex-wrap: wrap;
		gap: var(--space-2);
		margin-top: var(--space-6);
	}

	.case-hero__visual {
		display: grid;
		min-height: 22rem;
		overflow: hidden;
		border-radius: var(--radius-lg);
		padding: var(--space-6);
		background:
			radial-gradient(circle at 78% 20%, rgb(255 255 255 / 0.7) 0 9%, transparent 10%),
			linear-gradient(145deg, var(--color-surface-accent), var(--color-surface-muted));
		color: var(--color-accent-strong);
		place-items: center;
	}

	.case-hero__visual span {
		font-family: var(--font-mono);
		font-size: clamp(3rem, 9vw, 6rem);
		font-weight: 900;
	}

	.case-hero__visual p {
		max-width: 18rem;
		margin: auto 0 0;
		text-align: center;
		font-size: var(--text-xs);
		font-weight: 800;
		line-height: 1.6;
	}

	.case-hero__visual--image {
		display: block;
		padding: 0;
		background: var(--color-surface);
	}

	.case-hero__visual--image img {
		width: 100%;
		height: 100%;
		min-height: 22rem;
		object-fit: cover;
		object-position: top;
	}

	.project-meta {
		display: grid;
		margin: var(--space-10) 0 0;
		border-block: var(--border-default);
		grid-template-columns: repeat(3, minmax(0, 1fr));
	}

	.project-meta div {
		padding: var(--space-6);
	}

	.project-meta div + div {
		border-left: var(--border-default);
	}

	dt {
		color: var(--color-accent-strong);
		font-size: var(--text-xs);
		font-weight: 900;
		letter-spacing: 0.05em;
		text-transform: uppercase;
	}

	dd {
		margin: var(--space-2) 0 0;
		color: var(--color-text-soft);
		font-size: var(--text-sm);
		line-height: 1.65;
	}

	.external-links {
		display: flex;
		flex-wrap: wrap;
		gap: var(--space-3);
		margin-top: var(--space-6);
	}

	.artifact-showcase {
		margin-top: var(--space-12);
		border-top: var(--border-default);
		padding-top: var(--space-10);
	}

	.artifact-showcase__heading h2 {
		margin: 0;
		font-size: var(--text-xl);
		letter-spacing: -0.025em;
	}

	.artifact-list {
		display: grid;
		gap: var(--space-8);
		margin-top: var(--space-8);
	}

	.artifact-card {
		overflow: hidden;
		border: var(--border-default);
		border-radius: var(--radius-lg);
		background: var(--color-surface);
		box-shadow: var(--shadow-card);
	}

	.artifact-card__preview {
		display: block;
		border-bottom: var(--border-default);
		background: #ffffff;
	}

	.artifact-card__preview img {
		width: 100%;
		height: auto;
	}

	.artifact-card__content {
		display: flex;
		align-items: end;
		justify-content: space-between;
		gap: var(--space-8);
		padding: var(--space-6);
	}

	.artifact-card h3,
	.artifact-card p {
		margin: 0;
	}

	.artifact-card h3 {
		font-size: var(--text-lg);
	}

	.artifact-card p {
		max-width: var(--width-reading);
		margin-top: var(--space-3);
		color: var(--color-text-soft);
		line-height: var(--leading-body);
	}

	.artifact-card__actions {
		display: flex;
		flex: 0 0 auto;
		flex-wrap: wrap;
		gap: var(--space-2);
	}

	.artifact-card__actions a {
		display: inline-flex;
		min-height: 2.75rem;
		align-items: center;
		gap: var(--space-2);
		border: var(--border-default);
		border-radius: var(--radius-pill);
		padding-inline: var(--space-4);
		color: var(--color-accent-strong);
		font-size: var(--text-sm);
		font-weight: 850;
		text-decoration: none;
	}

	.case-contents {
		margin-top: var(--space-12);
		border-radius: var(--radius-lg);
		padding: var(--space-6);
		background: var(--color-surface-muted);
	}

	.case-contents > p {
		margin: 0;
		font-size: var(--text-sm);
		font-weight: 900;
	}

	.case-contents ol {
		display: grid;
		margin: var(--space-4) 0 0;
		padding: 0;
		grid-template-columns: repeat(3, minmax(0, 1fr));
		gap: var(--space-2) var(--space-6);
		list-style: none;
	}

	.case-contents a {
		display: flex;
		gap: var(--space-2);
		color: var(--color-text-soft);
		font-size: var(--text-sm);
		text-decoration: none;
	}

	.case-contents a:hover {
		color: var(--color-accent-strong);
		text-decoration: underline;
	}

	.case-contents a span {
		color: var(--color-accent);
		font-family: var(--font-mono);
		font-size: var(--text-xs);
	}

	.case-study {
		margin-top: var(--space-8);
	}

	.case-section {
		display: grid;
		scroll-margin-top: 7rem;
		border-top: var(--border-default);
		padding: clamp(var(--space-10), 8vw, var(--space-20)) 0;
		grid-template-columns: 4rem minmax(0, 1fr);
		gap: var(--space-6);
	}

	.case-section__index {
		margin: 0;
		color: var(--color-accent);
		font-family: var(--font-mono);
		font-size: var(--text-sm);
		font-weight: 800;
	}

	.case-section h2 {
		margin: 0;
		font-size: var(--text-xl);
		letter-spacing: -0.025em;
	}

	.case-section h3 {
		margin: 0;
		font-size: var(--text-md);
	}

	.case-section p,
	.case-section li {
		color: var(--color-text-soft);
		line-height: var(--leading-body);
	}

	.case-section ul {
		display: grid;
		gap: var(--space-3);
		margin: var(--space-6) 0 0;
		padding-left: var(--space-5);
	}

	.lead-copy {
		max-width: 46rem;
