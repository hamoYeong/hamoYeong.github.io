---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import ProjectCard from '../../../components/ProjectCard.astro';
import SectionHeading from '../../../components/SectionHeading.astro';
import {
	getLocaleStaticPaths,
	isLocale,
	locales,
	localizedPath,
	type LocalePaths,
} from '../../../i18n/config';
import { getUi } from '../../../i18n/ui';
import { getProjects } from '../../../lib/content';

export const getStaticPaths = getLocaleStaticPaths;

const localeParam = Astro.params.locale;
if (!isLocale(localeParam)) {
	throw new Error(`Unsupported locale: ${localeParam}`);
}

const locale = localeParam;
const t = getUi(locale);
const projects = (await getProjects({ locale })).sort(
	(left, right) =>
		left.data.priority - right.data.priority ||
		right.data.period.start.localeCompare(left.data.period.start),
);
const projectGroups = [
	{
		key: 'featured',
		title: t.projects.featuredGalleryTitle,
		description: t.projects.featuredGalleryIntro,
		projects: projects.filter((project) => project.data.featured),
		variant: 'featured' as const,
	},
	{
		key: 'more',
		title: t.projects.moreGalleryTitle,
		description: t.projects.moreGalleryIntro,
		projects: projects.filter((project) => !project.data.featured),
		variant: 'compact' as const,
	},
];
const getFilterValues = (categories: string[]) => {
	const normalized = categories.map((category) => category.toLowerCase());
	const values = [];

	if (normalized.includes('ios')) values.push('ios');
	if (normalized.includes('web')) values.push('web');
	if (
		normalized.some((category) =>
			['education', 'computational thinking', 'learning'].includes(category),
		)
	) {
		values.push('education');
	}
	if (normalized.includes('community')) values.push('community');

	return values;
};
const alternatePaths = Object.fromEntries(
	locales.map((targetLocale) => [
		targetLocale,
		localizedPath(targetLocale, 'projects'),
	]),
) as LocalePaths;
---

<BaseLayout
	locale={locale}
	title={`${t.nav.projects} | Hamo`}
	description={t.projects.intro}
	alternatePaths={alternatePaths}
>
	<SectionHeading
		level="h1"
		eyebrow={t.projects.eyebrow}
		title={t.projects.title}
		description={t.projects.intro}
	/>

	{
		projects.length > 0 ? (
			<>
				<div
					class="project-filter"
					data-project-filter
					role="group"
					aria-label={t.projects.filterLabel}
				>
					<div class="project-filter__buttons">
						<button
							type="button"
							data-filter="all"
							aria-pressed="true"
							aria-controls="project-list"
						>
							{t.projects.filterAll}
						</button>
						{t.projects.filters.map((filter) => (
							<button
								type="button"
								data-filter={filter.value}
								aria-pressed="false"
								aria-controls="project-list"
							>
								{filter.label}
							</button>
						))}
					</div>
					<p aria-live="polite" data-project-count data-count-suffix={t.projects.filterCount}>
						{projects.length}{t.projects.filterCount}
					</p>
				</div>

				<div id="project-list" class="project-groups">
					{projectGroups.map((group) => (
						<section class="project-group" data-project-group>
							<div class="project-group__heading">
								<h2>{group.title}</h2>
								<p>{group.description}</p>
							</div>
							<div class="card-grid">
								{group.projects.map((project) => (
									<div
										class="project-entry"
										data-project-entry
										data-categories={getFilterValues(project.data.categories).join(' ')}
									>
										<ProjectCard
											title={project.data.title}
											headingLevel="h3"
											summary={project.data.summary}
											summaryNote={project.data.summaryNote}
											meta={`${project.data.categories[0] ?? ''} · ${project.data.period.label} · ${t.projects.statusLabels[project.data.status]}`}
											tags={project.data.technologies.slice(0, 3)}
											facts={[
												{ label: t.projects.role, value: project.data.role.slice(0, 2).join(', ') },
												{ label: t.projects.outcomes, value: project.data.outcomes[0] },
											]}
											image={project.data.coverImage}
											href={localizedPath(locale, `projects/${project.data.slug}`)}
											actionLabel={t.projects.readMore}
											variant={group.variant}
										/>
									</div>
								))}
							</div>
						</section>
					))}
				</div>
			</>
		) : (
			<p class="empty-state">{t.projects.empty}</p>
		)
	}
</BaseLayout>

<script>
	const filterRoot = document.querySelector('[data-project-filter]');
	const projectEntries = Array.from(
		document.querySelectorAll<HTMLElement>('[data-project-entry]'),
	);

	if (filterRoot) {
		const filterButtons = Array.from(
			filterRoot.querySelectorAll<HTMLButtonElement>('button[data-filter]'),
		);
		const count = filterRoot.querySelector<HTMLElement>('[data-project-count]');

		filterButtons.forEach((button) => {
			button.addEventListener('click', () => {
				const selected = button.dataset.filter ?? 'all';
				let visibleCount = 0;

				filterButtons.forEach((candidate) => {
					candidate.setAttribute(
						'aria-pressed',
						String(candidate === button),
					);
				});

				projectEntries.forEach((entry) => {
					const categories = entry.dataset.categories?.split(' ') ?? [];
					const visible = selected === 'all' || categories.includes(selected);
					entry.hidden = !visible;
					if (visible) visibleCount += 1;
				});

				document.querySelectorAll<HTMLElement>('[data-project-group]').forEach((group) => {
					const hasVisibleProject = Array.from(
						group.querySelectorAll<HTMLElement>('[data-project-entry]'),
					).some((entry) => !entry.hidden);
					group.hidden = !hasVisibleProject;
				});

				if (count) {
					count.textContent = `${visibleCount}${count.dataset.countSuffix ?? ''}`;
				}
			});
		});
	}
</script>

<style>
	.project-filter {
		display: flex;
		margin: var(--space-8) 0 var(--space-8);
		align-items: center;
		justify-content: space-between;
		gap: var(--space-4);
	}

	.project-filter__buttons {
		display: flex;
		flex-wrap: wrap;
		gap: var(--space-2);
	}

	.project-filter button {
		min-height: 2.75rem;
		border: var(--border-default);
		border-radius: var(--radius-pill);
		padding: 0 var(--space-4);
		background: var(--color-surface);
		color: var(--color-text-soft);
		font: inherit;
		font-size: var(--text-sm);
		font-weight: 800;
		cursor: pointer;
	}

	.project-filter button[aria-pressed='true'] {
		border-color: var(--color-accent);
		background: var(--color-accent);
		color: var(--color-on-accent);
	}

	.project-filter p {
		flex: 0 0 auto;
		margin: 0;
		color: var(--color-text-faint);
		font-size: var(--text-sm);
	}

	.project-entry {
		min-width: 0;
	}

	.project-entry[hidden] {
		display: none;
	}

	.project-groups {
		display: grid;
		gap: clamp(var(--space-16), 8vw, var(--space-24));
	}

	.project-group[hidden] {
		display: none;
	}

	.project-group__heading {
		display: grid;
		grid-template-columns: minmax(0, 0.7fr) minmax(18rem, 1fr);
		gap: var(--space-8);
		align-items: end;
		border-top: var(--border-default);
		padding-top: var(--space-8);
	}

	.project-group__heading h2,
	.project-group__heading p {
		margin: 0;
	}

	.project-group__heading h2 {
		font-size: var(--text-xl);
		letter-spacing: -0.025em;
	}

	.project-group__heading p {
		max-width: var(--width-reading);
		color: var(--color-text-soft);
		line-height: var(--leading-body);
	}

	.project-group .card-grid {
		margin-top: var(--space-8);
	}

	@media (max-width: 640px) {
		.project-filter {
			align-items: flex-start;
			flex-direction: column;
		}

		.project-group__heading {
			grid-template-columns: 1fr;
			gap: var(--space-3);
		}
	}
</style>
