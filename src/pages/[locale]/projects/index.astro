---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import ProjectCard from '../../../components/ProjectCard.astro';
import SectionHeading from '../../../components/SectionHeading.astro';
import {
	getLocaleStaticPaths,
	isLocale,
	locales,
	localizedPath,
	type LocalePaths,
} from '../../../i18n/config';
import { getUi } from '../../../i18n/ui';
import { getProjects } from '../../../lib/content';

export const getStaticPaths = getLocaleStaticPaths;

const localeParam = Astro.params.locale;
if (!isLocale(localeParam)) {
	throw new Error(`Unsupported locale: ${localeParam}`);
}

const locale = localeParam;
const t = getUi(locale);
const projects = await getProjects({ locale });
const alternatePaths = Object.fromEntries(
	locales.map((targetLocale) => [
		targetLocale,
		localizedPath(targetLocale, 'projects'),
	]),
) as LocalePaths;
---

<BaseLayout
	locale={locale}
	title={`${t.nav.projects} | Hamo`}
	description={t.projects.intro}
	alternatePaths={alternatePaths}
>
	<SectionHeading
		level="h1"
		eyebrow={t.projects.eyebrow}
		title={t.projects.title}
		description={t.projects.intro}
	/>

	{
		projects.length > 0 ? (
			<div class="card-grid">
				{projects.map((project) => (
					<ProjectCard
						title={project.data.title}
						summary={project.data.summary}
						meta={project.data.period.label}
						tags={project.data.technologies}
						href={localizedPath(locale, `projects/${project.data.slug}`)}
						actionLabel={t.projects.readMore}
					/>
				))}
			</div>
		) : (
			<p class="empty-state">{t.projects.empty}</p>
		)
	}
</BaseLayout>
