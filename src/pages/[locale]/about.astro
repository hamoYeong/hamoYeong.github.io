---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SectionHeading from '../../components/SectionHeading.astro';
import TimelineItem from '../../components/TimelineItem.astro';
import {
	getLocaleStaticPaths,
	isLocale,
	locales,
	localizedPath,
	type LocalePaths,
} from '../../i18n/config';
import { getUi } from '../../i18n/ui';
import { getExperiences } from '../../lib/content';

export const getStaticPaths = getLocaleStaticPaths;

const localeParam = Astro.params.locale;
if (!isLocale(localeParam)) {
	throw new Error(`Unsupported locale: ${localeParam}`);
}

const locale = localeParam;
const t = getUi(locale);
const experiences = await getExperiences({ locale });
const alternatePaths = Object.fromEntries(
	locales.map((targetLocale) => [
		targetLocale,
		localizedPath(targetLocale, 'about'),
	]),
) as LocalePaths;
---

<BaseLayout
	locale={locale}
	title={`${t.nav.about} | Hamo`}
	description={t.about.intro}
	alternatePaths={alternatePaths}
>
	<SectionHeading
		level="h1"
		eyebrow={t.about.eyebrow}
		title={t.about.title}
		description={t.about.intro}
	/>

	<section class="content-section" aria-labelledby="principles-title">
		<SectionHeading
			id="principles-title"
			title={t.about.principlesTitle}
		/>
		<ul class="principles">
			{t.about.principles.map((principle) => <li>{principle}</li>)}
		</ul>
	</section>

	<section class="content-section" aria-labelledby="experience-title">
		<SectionHeading
			id="experience-title"
			title={t.about.experienceTitle}
		/>
		{
			experiences.length > 0 ? (
				<div class="timeline-list">
					{experiences.map((experience) => (
						<TimelineItem
							period={experience.data.period.label}
							title={experience.data.title}
							organization={experience.data.organization}
							summary={experience.data.summary}
						/>
					))}
				</div>
			) : (
				<p class="empty-state">{t.about.experienceEmpty}</p>
			)
		}
	</section>
</BaseLayout>

<style>
	.principles {
		display: grid;
		gap: var(--space-3);
		max-width: var(--width-reading);
		margin: var(--space-6) 0 0;
		padding-left: var(--space-6);
		color: var(--color-text-soft);
		line-height: var(--leading-body);
	}

	.timeline-list {
		display: grid;
		margin-top: var(--space-8);
	}
</style>
