---
import { render, type CollectionEntry } from 'astro:content';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Tag from '../../../components/Tag.astro';
import {
	formatDate,
	locales,
	localizedPath,
	type LocalePaths,
} from '../../../i18n/config';
import { getUi } from '../../../i18n/ui';
import {
	findTranslation,
	getPosts,
} from '../../../lib/content';

interface Props {
	post: CollectionEntry<'posts'>;
}

export async function getStaticPaths() {
	const posts = await getPosts();

	return posts.map((post) => ({
		params: {
			locale: post.data.locale,
			slug: post.data.slug,
		},
		props: { post },
	}));
}

const { post } = Astro.props;
const locale = post.data.locale;
const t = getUi(locale);
const { Content } = await render(post);
const allPosts = await getPosts();
const alternatePaths = Object.fromEntries(
	locales.map((targetLocale) => {
		const translation = findTranslation(
			allPosts,
			post.data.translationKey,
			targetLocale,
		);
		const path = translation
			? localizedPath(targetLocale, `posts/${translation.data.slug}`)
			: localizedPath(targetLocale, 'posts');

		return [targetLocale, path];
	}),
) as LocalePaths;
---

<BaseLayout
	locale={locale}
	title={`${post.data.title} | Hamo`}
	description={post.data.description}
	alternatePaths={alternatePaths}
>
	<div class="article-shell">
		<a class="back-link" href={localizedPath(locale, 'posts')}>← {t.posts.back}</a>

		<article>
		<header class="article-header">
			<p class="eyebrow">{t.posts.eyebrow}</p>
			<h1>{post.data.title}</h1>
			<p class="article-summary">{post.data.description}</p>
			<dl class="post-meta">
				<div>
					<dt>{t.posts.publishedAt}</dt>
					<dd>{formatDate(post.data.publishedAt, locale)}</dd>
				</div>
				{
					post.data.updatedAt && (
						<div>
							<dt>{t.posts.updatedAt}</dt>
							<dd>{formatDate(post.data.updatedAt, locale)}</dd>
						</div>
					)
				}
			</dl>
			<div class="tag-list" aria-label={t.posts.tags}>
				{post.data.tags.map((tag) => <Tag label={tag} />)}
			</div>
		</header>

		<div class="article-content">
			<Content />
		</div>
	</article>
	</div>
</BaseLayout>

<style>
	.post-meta {
		display: flex;
		flex-wrap: wrap;
		gap: var(--space-6);
		margin: var(--space-8) 0 0;
		font-size: var(--text-sm);
	}

	.post-meta div {
		display: flex;
		gap: var(--space-2);
	}

	dt {
		font-weight: 850;
	}

	dd {
		margin: 0;
		color: var(--color-text-soft);
	}

	.tag-list {
		display: flex;
		flex-wrap: wrap;
		gap: var(--space-2);
		margin-top: var(--space-4);
	}
</style>
