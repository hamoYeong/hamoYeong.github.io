---
import { render, type CollectionEntry } from 'astro:content';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import ProjectCard from '../../../components/ProjectCard.astro';
import Tag from '../../../components/Tag.astro';
import {
	formatDate,
	locales,
	localizedPath,
	type LocalePaths,
} from '../../../i18n/config';
import { getUi } from '../../../i18n/ui';
import {
	findTranslation,
	getPosts,
	getProjects,
} from '../../../lib/content';

interface Props {
	post: CollectionEntry<'posts'>;
}

export async function getStaticPaths() {
	const posts = await getPosts();

	return posts.map((post) => ({
		params: {
			locale: post.data.locale,
			slug: post.data.slug,
		},
		props: { post },
	}));
}

const { post } = Astro.props;
const locale = post.data.locale;
const t = getUi(locale);
const { Content, headings } = await render(post);
const [allPosts, projects] = await Promise.all([
	getPosts(),
	getProjects({ locale }),
]);
const articleHeadings = headings.filter((heading) => heading.depth === 2);
const relatedProjects = projects.filter((project) =>
	post.data.relatedProjects.includes(project.data.translationKey),
);
const alternatePaths = Object.fromEntries(
	locales.map((targetLocale) => {
		const translation = findTranslation(
			allPosts,
			post.data.translationKey,
			targetLocale,
		);
		const path = translation
			? localizedPath(targetLocale, `posts/${translation.data.slug}`)
			: localizedPath(targetLocale, 'posts');

		return [targetLocale, path];
	}),
) as LocalePaths;
---

<BaseLayout
	locale={locale}
	title={`${post.data.title} | Hamo`}
	description={post.data.description}
	alternatePaths={alternatePaths}
>
	<div class="article-shell">
		<a class="back-link" href={localizedPath(locale, 'posts')}>← {t.posts.back}</a>

		<article id="article-content">
		<header class="article-header">
			<p class="eyebrow">{t.posts.eyebrow}</p>
			<h1>{post.data.title}</h1>
			<p class="article-summary">{post.data.description}</p>
			<dl class="post-meta">
				<div>
					<dt>{t.posts.publishedAt}</dt>
					<dd>{formatDate(post.data.publishedAt, locale)}</dd>
				</div>
				{
					post.data.updatedAt && (
						<div>
							<dt>{t.posts.updatedAt}</dt>
							<dd>{formatDate(post.data.updatedAt, locale)}</dd>
						</div>
					)
				}
			</dl>
			<div class="tag-list" aria-label={t.posts.tags}>
				{post.data.tags.map((tag) => <Tag label={tag} />)}
			</div>
		</header>

		{
			articleHeadings.length > 0 && (
				<nav class="post-contents" aria-label={t.posts.onThisPage}>
					<p>{t.posts.onThisPage}</p>
					<ol>
						{articleHeadings.map((heading, index) => (
							<li>
								<a href={`#${heading.slug}`}>
									<span>{String(index + 1).padStart(2, '0')}</span>
									{heading.text}
								</a>
							</li>
						))}
					</ol>
				</nav>
			)
		}

		<div class="article-content">
			<Content />
		</div>

		{
			relatedProjects.length > 0 && (
				<section class="related-projects" aria-labelledby="related-projects-title">
					<div>
						<p class="eyebrow">{t.projects.eyebrow}</p>
						<h2 id="related-projects-title">{t.posts.relatedProjects}</h2>
						<p>{t.posts.relatedProjectsIntro}</p>
					</div>
					<div class="related-projects__grid">
						{relatedProjects.map((project) => (
							<ProjectCard
								title={project.data.title}
								headingLevel="h3"
								summary={project.data.summary}
								summaryNote={project.data.summaryNote}
								meta={project.data.period.label}
								tags={project.data.technologies.slice(0, 3)}
								href={localizedPath(locale, `projects/${project.data.slug}`)}
								actionLabel={t.projects.readMore}
							/>
						))}
					</div>
				</section>
			)
		}
	</article>
	</div>
</BaseLayout>

<style>
	.post-meta {
		display: flex;
		flex-wrap: wrap;
		gap: var(--space-6);
		margin: var(--space-8) 0 0;
		font-size: var(--text-sm);
	}

	.post-meta div {
		display: flex;
		gap: var(--space-2);
	}

	dt {
		font-weight: 850;
	}

	dd {
		margin: 0;
		color: var(--color-text-soft);
	}

	.tag-list {
		display: flex;
		flex-wrap: wrap;
		gap: var(--space-2);
		margin-top: var(--space-4);
	}

	.post-contents {
		margin-top: var(--space-10);
		border: var(--border-default);
		border-radius: var(--radius-md);
		padding: var(--space-5) var(--space-6);
		background: var(--color-surface-muted);
	}

	.post-contents > p {
		margin: 0;
		font-size: var(--text-sm);
		font-weight: 900;
	}

	.post-contents ol {
		display: grid;
		margin: var(--space-4) 0 0;
		padding: 0;
		gap: var(--space-2);
		list-style: none;
	}

	.post-contents a {
		display: flex;
		gap: var(--space-3);
		color: var(--color-text-soft);
		font-size: var(--text-sm);
		line-height: 1.6;
		text-decoration: none;
	}

	.post-contents a:hover {
		color: var(--color-accent-strong);
		text-decoration: underline;
	}

	.post-contents a span {
		color: var(--color-accent);
		font-family: var(--font-mono);
		font-size: var(--text-xs);
	}

	.article-content :global(h2),
	.article-content :global(h3) {
		scroll-margin-top: 7rem;
	}

	.article-content :global(p) {
		margin-block: var(--space-5);
	}

	.article-content :global(ul),
	.article-content :global(ol) {
		display: grid;
		padding-left: var(--space-6);
		gap: var(--space-2);
	}

	.article-content :global(blockquote) {
		margin: var(--space-8) 0;
		border-left: 4px solid var(--color-accent);
		border-radius: 0 var(--radius-md) var(--radius-md) 0;
		padding: var(--space-4) var(--space-6);
		background: var(--color-surface-accent);
	}

	.article-content :global(blockquote p) {
		margin: 0;
		color: var(--color-text-soft);
		font-size: 1rem;
	}

	.article-content :global(code) {
		border-radius: var(--radius-sm);
		padding: 0.15em 0.35em;
		background: var(--color-surface-muted);
		font-family: var(--font-mono);
		font-size: 0.9em;
	}

	.article-content :global(pre) {
		overflow-x: auto;
		margin: var(--space-8) 0;
		border: 1px solid var(--color-border-strong);
		border-radius: var(--radius-md);
		padding: var(--space-5);
		background: var(--color-text);
		color: var(--color-canvas);
		line-height: 1.7;
		tab-size: 2;
	}

	.article-content :global(pre code) {
		padding: 0;
		background: transparent;
		color: inherit;
		font-size: var(--text-sm);
	}

	.article-content :global(img) {
		display: block;
		max-width: 100%;
		height: auto;
		margin: var(--space-8) auto;
		border: var(--border-default);
		border-radius: var(--radius-md);
	}

	.article-content :global(figure) {
		margin: var(--space-8) 0;
	}

	.article-content :global(figcaption) {
		margin-top: var(--space-3);
		color: var(--color-text-faint);
		font-size: var(--text-sm);
		line-height: 1.6;
		text-align: center;
	}

	.article-content :global(table) {
		display: block;
		width: 100%;
		overflow-x: auto;
		border-collapse: collapse;
	}

	.article-content :global(th),
	.article-content :global(td) {
		border-bottom: var(--border-default);
		padding: var(--space-3);
		text-align: left;
		white-space: nowrap;
	}

	.article-content :global(hr) {
		margin: var(--space-12) 0;
		border: 0;
		border-top: var(--border-default);
	}

	.related-projects {
		margin-top: var(--space-16);
		border-top: var(--border-default);
		padding-top: var(--space-10);
	}

	.related-projects h2 {
		margin: 0;
		font-size: var(--text-xl);
		letter-spacing: -0.025em;
	}

	.related-projects > div:first-child > p:last-child {
		max-width: var(--width-reading);
		color: var(--color-text-soft);
		line-height: var(--leading-body);
	}

	.related-projects__grid {
		display: grid;
		margin-top: var(--space-8);
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: var(--space-5);
	}

	@media (max-width: 720px) {
		.related-projects__grid {
			grid-template-columns: 1fr;
		}
	}
</style>
