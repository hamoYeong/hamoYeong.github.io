---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import {
	formatDate,
	getLocaleStaticPaths,
	isLocale,
	locales,
	localizedPath,
	type LocalePaths,
} from '../../../i18n/config';
import { getUi } from '../../../i18n/ui';
import { getPosts } from '../../../lib/content';

export const getStaticPaths = getLocaleStaticPaths;

const localeParam = Astro.params.locale;
if (!isLocale(localeParam)) {
	throw new Error(`Unsupported locale: ${localeParam}`);
}

const locale = localeParam;
const t = getUi(locale);
const posts = await getPosts({ locale });
const alternatePaths = Object.fromEntries(
	locales.map((targetLocale) => [
		targetLocale,
		localizedPath(targetLocale, 'posts'),
	]),
) as LocalePaths;
---

<BaseLayout
	locale={locale}
	title={`${t.nav.posts} | Hamo`}
	description={t.posts.intro}
	alternatePaths={alternatePaths}
>
	<section class="page-intro">
		<p class="eyebrow">{t.posts.eyebrow}</p>
		<h1>{t.posts.title}</h1>
		<p>{t.posts.intro}</p>
	</section>

	{
		posts.length > 0 ? (
			<div class="post-list">
				{posts.map((post) => (
					<article>
						<p class="date">{formatDate(post.data.publishedAt, locale)}</p>
						<h2>{post.data.title}</h2>
						<p>{post.data.description}</p>
						<ul aria-label={t.posts.tags}>
							{post.data.tags.map((tag) => (
								<li>{tag}</li>
							))}
						</ul>
						<a href={localizedPath(locale, `posts/${post.data.slug}`)}>
							{t.posts.readMore}
						</a>
					</article>
				))}
			</div>
		) : (
			<p class="empty">{t.posts.empty}</p>
		)
	}
</BaseLayout>

<style>
	.eyebrow {
		margin: 0 0 1rem;
		color: #4d6f92;
		font-size: 0.85rem;
		font-weight: 800;
		text-transform: uppercase;
	}

	.post-list {
		display: grid;
		gap: 1rem;
		margin-top: 3.5rem;
	}

	article {
		max-width: 48rem;
		border-top: 1px solid #e0e3e7;
		padding-top: 1.5rem;
	}

	h2 {
		margin: 0.5rem 0 0;
		font-size: 1.4rem;
	}

	article p {
		color: #59616b;
		line-height: 1.65;
	}

	.date {
		margin: 0;
		font-size: 0.85rem;
	}

	ul {
		display: flex;
		flex-wrap: wrap;
		gap: 0.4rem;
		margin: 1rem 0 0;
		padding: 0;
		list-style: none;
	}

	li {
		border-radius: 999px;
		padding: 0.3rem 0.6rem;
		background: #f1f3f5;
		font-size: 0.8rem;
	}

	article a {
		display: inline-block;
		margin-top: 1.25rem;
		color: #294e75;
		font-weight: 800;
		text-decoration: underline;
		text-underline-offset: 0.25em;
	}

	.empty {
		margin-top: 3rem;
		color: #686f78;
	}
</style>
