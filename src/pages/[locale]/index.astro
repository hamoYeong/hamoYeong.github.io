---
import BaseLayout from '../../layouts/BaseLayout.astro';
import {
	getLocaleStaticPaths,
	isLocale,
	locales,
	localizedPath,
	type LocalePaths,
} from '../../i18n/config';
import { getUi } from '../../i18n/ui';

export const getStaticPaths = getLocaleStaticPaths;

const localeParam = Astro.params.locale;
if (!isLocale(localeParam)) {
	throw new Error(`Unsupported locale: ${localeParam}`);
}

const locale = localeParam;
const t = getUi(locale);
const alternatePaths = Object.fromEntries(
	locales.map((targetLocale) => [targetLocale, localizedPath(targetLocale)]),
) as LocalePaths;
---

<BaseLayout locale={locale} alternatePaths={alternatePaths}>
	<section class="hero">
		<p class="eyebrow">{t.home.eyebrow}</p>
		<p class="name">{t.home.name} <span>{t.home.alias}</span></p>
		<h1>{t.home.title}</h1>
		<p class="intro">{t.home.intro}</p>
		<div class="actions">
			<a class="primary-link" href={localizedPath(locale, 'about')}>
				{t.home.aboutAction}
			</a>
			<a href={localizedPath(locale, 'projects')}>{t.home.projectsAction}</a>
			<a href={localizedPath(locale, 'posts')}>{t.home.postsAction}</a>
		</div>
	</section>

	<section class="interests" aria-labelledby="interests-title">
		<h2 id="interests-title">{t.home.interestsTitle}</h2>
		<p>{t.home.interests}</p>
	</section>

	<section class="site-guide" aria-labelledby="site-guide-title">
		<h2 id="site-guide-title">{t.home.guideTitle}</h2>
		<div class="section-grid">
			{
				t.home.guides.map((guide) => (
					<article>
						<h3>{guide.title}</h3>
						<p>{guide.description}</p>
						<a href={localizedPath(locale, guide.path)}>{guide.action}</a>
					</article>
				))
			}
		</div>
	</section>
</BaseLayout>

<style>
	.hero {
		max-width: 46rem;
	}

	.eyebrow {
		margin-bottom: var(--space-5);
	}

	.name {
		margin: 0 0 var(--space-5);
		color: var(--color-text);
		font-size: 1.05rem;
		font-weight: 800;
	}

	.name span {
		margin-left: var(--space-2);
		color: var(--color-text-faint);
		font-weight: 600;
	}

	h1 {
		max-width: 15ch;
		margin: 0;
		font-size: var(--text-display);
		line-height: var(--leading-tight);
		letter-spacing: -0.045em;
		word-break: keep-all;
	}

	.intro {
		max-width: var(--width-reading);
		margin: var(--space-8) 0 0;
		color: var(--color-text-soft);
		font-size: var(--text-md);
		line-height: var(--leading-body);
	}

	.actions {
		display: flex;
		flex-wrap: wrap;
		gap: var(--space-3);
		margin-top: var(--space-8);
	}

	.actions a {
		display: inline-flex;
		min-height: 2.75rem;
		align-items: center;
		border: var(--border-default);
		border-radius: var(--radius-pill);
		padding-inline: var(--space-5);
		background: var(--color-surface);
		color: var(--color-text);
		font-size: var(--text-sm);
		font-weight: 800;
		text-decoration: none;
	}

	.actions a:hover {
		border-color: var(--color-accent);
		color: var(--color-accent-strong);
	}

	.actions .primary-link {
		border-color: var(--color-accent);
		background: var(--color-accent);
		color: var(--color-on-accent);
	}

	.interests,
	.site-guide {
		margin-top: clamp(var(--space-16), 8vw, 7rem);
		border-top: var(--border-default);
		padding-top: var(--space-8);
	}

	h2 {
		margin: 0 0 var(--space-5);
		font-size: 1.2rem;
	}

	.interests p,
	article p {
		color: var(--color-text-soft);
		line-height: var(--leading-body);
	}

	.interests p {
		max-width: var(--width-reading);
		margin: 0;
		font-size: var(--text-md);
	}

	.section-grid {
		display: grid;
		grid-template-columns: repeat(3, minmax(0, 1fr));
		gap: var(--space-5);
	}

	article {
		border: var(--border-default);
		border-radius: var(--radius-md);
		padding: var(--space-5);
		background: var(--color-surface);
	}

	h3,
	article p {
		margin: 0;
	}

	article p {
		margin-top: var(--space-3);
	}

	article a {
		display: inline-flex;
		min-height: 2.75rem;
		margin-top: var(--space-4);
		align-items: center;
		color: var(--color-accent-strong);
		font-weight: 700;
	}

	@media (max-width: 640px) {
		h1 {
			font-size: clamp(2.75rem, 14vw, 4rem);
		}

		.section-grid {
			grid-template-columns: 1fr;
			gap: 1.5rem;
		}
	}
</style>
