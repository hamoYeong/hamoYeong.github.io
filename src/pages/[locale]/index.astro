---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ExternalLink from '../../components/ExternalLink.astro';
import PostCard from '../../components/PostCard.astro';
import ProjectCard from '../../components/ProjectCard.astro';
import SectionHeading from '../../components/SectionHeading.astro';
import {
	formatDate,
	getLocaleStaticPaths,
	isLocale,
	locales,
	localizedPath,
	type LocalePaths,
} from '../../i18n/config';
import { getUi } from '../../i18n/ui';
import { getPosts, getProjects } from '../../lib/content';

export const getStaticPaths = getLocaleStaticPaths;

const localeParam = Astro.params.locale;
if (!isLocale(localeParam)) {
	throw new Error(`Unsupported locale: ${localeParam}`);
}

const locale = localeParam;
const t = getUi(locale);
const alternatePaths = Object.fromEntries(
	locales.map((targetLocale) => [targetLocale, localizedPath(targetLocale)]),
) as LocalePaths;
const [projects, posts] = await Promise.all([
	getProjects({ locale }),
	getPosts({ locale }),
]);
const featuredProjects = projects
	.filter((project) => project.data.featured)
	.slice(0, 3);
const latestPosts = posts.slice(0, 3);
const githubUrl = 'https://github.com/hamoYeong';
const linkedinUrl = 'https://www.linkedin.com/in/seoyeong-kim-hamoyeong';
const publicEmail = 'rlatjdud6573@naver.com';
---

<BaseLayout
	title={`${t.home.name} | Hamo`}
	description={t.home.intro}
	locale={locale}
	alternatePaths={alternatePaths}
>
	<section class="hero" aria-labelledby="hero-title">
		<div class="hero-meta">
			<p class="eyebrow">{t.home.eyebrow}</p>
			<p class="name">{t.home.name} <span>{t.home.alias}</span></p>
		</div>

		<div class="hero-copy">
			<p class="question">{t.home.selfQuestion}</p>
			<h1 id="hero-title">{t.home.title}</h1>
			<p class="intro">{t.home.intro}</p>
			<div class="hero-actions">
				<a class="story-link" href="#story">
					{t.home.storyAction} <span aria-hidden="true">↓</span>
				</a>
				<a href={localizedPath(locale, 'about')}>{t.home.aboutAction}</a>
			</div>
		</div>
	</section>

	<section class="story" id="story" aria-label={t.home.storyAction}>
		<article class="story-block">
			<div class="story-heading">
				<p class="question">{t.home.reasonEyebrow}</p>
				<h2>{t.home.reasonTitle}</h2>
			</div>
			<div class="story-body">
				<p>{t.home.reasonDescription}</p>
				<a class="text-link" href={localizedPath(locale, 'about')}>
					{t.home.reasonAction} <span aria-hidden="true">↗</span>
				</a>
			</div>
		</article>

		<article class="story-block">
			<div class="story-heading">
				<p class="question">{t.home.experienceEyebrow}</p>
				<h2>{t.home.experienceTitle}</h2>
			</div>
			<div class="story-body">
				<p>{t.home.experienceDescription}</p>
				<div class="experience-path" aria-label={t.home.experienceEyebrow}>
					{
						t.home.experienceSteps.map((step, index) => (
							<>
								<span>{step}</span>
								{index < t.home.experienceSteps.length - 1 && (
									<i aria-hidden="true">→</i>
								)}
							</>
						))
					}
				</div>
				<a class="text-link" href={localizedPath(locale, 'projects')}>
					{t.home.experienceAction} <span aria-hidden="true">↗</span>
				</a>
			</div>
		</article>

		<article class="story-block">
			<div class="story-heading">
				<p class="question">{t.home.identityEyebrow}</p>
				<h2>{t.home.identityTitle}</h2>
			</div>
			<div class="story-body">
				<p>{t.home.identityDescription}</p>
				<div class="keywords" aria-label={t.home.identityEyebrow}>
					{t.home.identityKeywords.map((keyword) => <span>{keyword}</span>)}
				</div>
			</div>
		</article>
	</section>

	<section class="content-section capabilities" aria-labelledby="care-title">
		<SectionHeading
			id="care-title"
			eyebrow={t.home.careEyebrow}
			title={t.home.careTitle}
			description={t.home.careIntro}
		/>
		<div class="care-grid">
			{
				t.home.carePoints.map((point, index) => (
					<article class="care-card">
						<p class="care-card__index" aria-hidden="true">
							{String(index + 1).padStart(2, '0')}
						</p>
						<h3>{point.title}</h3>
						<p>{point.description}</p>
					</article>
				))
			}
		</div>
		<nav class="explore-links" aria-label={t.home.careTitle}>
			<a href={localizedPath(locale, 'about')}>{t.home.aboutAction} <span>↗</span></a>
			<a href={localizedPath(locale, 'projects')}>{t.home.projectsAction} <span>↗</span></a>
			<a href={localizedPath(locale, 'posts')}>{t.home.postsAction} <span>↗</span></a>
		</nav>
	</section>

	<section class="content-section" aria-labelledby="featured-title">
		<SectionHeading
			id="featured-title"
			eyebrow={t.home.featuredEyebrow}
			title={t.home.featuredTitle}
			description={t.home.featuredIntro}
		/>
		<div class="featured-grid">
			{
				featuredProjects.map((project) => (
					<ProjectCard
						title={project.data.title}
						summary={project.data.summary}
						meta={project.data.period.label}
						tags={project.data.technologies.slice(0, 3)}
						href={localizedPath(locale, `projects/${project.data.slug}`)}
						facts={[
							{ label: t.projects.problem, value: project.data.problem },
							{ label: t.projects.role, value: project.data.role.join(', ') },
							{ label: t.projects.outcomes, value: project.data.outcomes[0] },
						]}
						actionLabel={t.projects.readMore}
					/>
				))
			}
		</div>
		<a class="section-action" href={localizedPath(locale, 'projects')}>
			{t.home.projectsAction} <span aria-hidden="true">→</span>
		</a>
	</section>

	<section class="content-section" aria-labelledby="posts-title">
		<div class="section-with-action">
			<SectionHeading
				id="posts-title"
				eyebrow={t.home.postsEyebrow}
				title={t.home.postsTitle}
				description={t.home.postsIntro}
			/>
			<a href={localizedPath(locale, 'posts')}>{t.home.postsAction} →</a>
		</div>
		<div class="stack-list">
			{
				latestPosts.map((post) => (
					<PostCard
						title={post.data.title}
						description={post.data.description}
						date={formatDate(post.data.publishedAt, locale)}
						tags={post.data.tags}
						href={localizedPath(locale, `posts/${post.data.slug}`)}
						actionLabel={t.posts.readMore}
					/>
				))
			}
		</div>
	</section>

	<section class="closing" aria-labelledby="contact-title">
		<div>
			<p class="question">{t.home.contactEyebrow}</p>
			<h2 id="contact-title">{t.home.contactTitle}</h2>
			<p>{t.home.contactDescription}</p>
		</div>
		<div class="contact-links">
			<a class="contact-email" href={`mailto:${publicEmail}`}>
				{t.about.email}
			</a>
			<ExternalLink href={linkedinUrl}>{t.about.linkedin}</ExternalLink>
			<ExternalLink href={githubUrl}>{t.home.githubAction}</ExternalLink>
		</div>
	</section>
</BaseLayout>

<style>
	:global(body) {
		--color-accent: #758970;
		--color-accent-strong: #4e6250;
		--color-surface-accent: #e8eee2;
		--color-focus: #527158;
		--color-on-dark-accent: #dbe6d5;

		background:
			radial-gradient(circle at 82% 7%, rgba(220, 232, 211, 0.58), transparent 26rem),
			var(--color-canvas);
	}

	:global(.site-main) {
		padding-top: clamp(var(--space-10), 7vw, var(--space-20));
	}

	.hero {
		display: block;
		min-height: min(47rem, calc(100vh - 7rem));
		max-width: 64rem;
		padding-bottom: clamp(var(--space-20), 12vw, 10rem);
	}

	.hero-meta {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: var(--space-6);
		margin-bottom: clamp(var(--space-10), 7vw, var(--space-20));
	}

	.hero-meta .eyebrow {
		margin: 0;
	}

	.name {
		margin: 0;
		font-size: 1.05rem;
		font-weight: 850;
	}

	.name span {
		margin-left: var(--space-2);
		color: var(--color-text-faint);
		font-weight: 650;
	}

	.question {
		margin: 0;
		color: var(--color-text-faint);
		font-family: var(--font-mono);
		font-size: var(--text-xs);
		font-weight: 850;
		letter-spacing: 0.06em;
		text-transform: uppercase;
	}

	.hero-copy h1 {
		max-width: 17ch;
		margin: var(--space-6) 0 0;
		font-size: clamp(3.2rem, 6.6vw, 6.1rem);
		letter-spacing: -0.065em;
		line-height: 0.98;
		word-break: keep-all;
	}

	.intro {
		max-width: var(--width-reading);
		margin: var(--space-8) 0 0;
		color: var(--color-text-soft);
		font-size: var(--text-md);
		line-height: 1.85;
		word-break: keep-all;
	}

	.hero-actions {
		display: flex;
		flex-wrap: wrap;
		gap: var(--space-4);
		align-items: center;
		margin-top: var(--space-8);
	}

	.hero-actions a,
	.text-link {
		display: inline-flex;
		min-height: 2.75rem;
		align-items: center;
		gap: var(--space-3);
		color: var(--color-accent-strong);
		font-size: var(--text-sm);
		font-weight: 850;
		text-underline-offset: 0.3em;
	}

	.hero-actions .story-link {
		border-radius: var(--radius-pill);
		padding-inline: var(--space-5);
		background: #4e6250;
		color: var(--color-on-accent);
		text-decoration: none;
	}

	.story {
		border-top: var(--border-default);
	}

	.story-block {
		display: grid;
		grid-template-columns: minmax(0, 1fr) minmax(18rem, 0.85fr);
		gap: clamp(var(--space-10), 8vw, 8rem);
		border-bottom: var(--border-default);
		padding: clamp(var(--space-16), 9vw, 7.5rem) 0;
	}

	.story-heading h2,
	.closing h2 {
		margin: var(--space-5) 0 0;
		font-size: clamp(2.2rem, 4.7vw, 4.4rem);
		letter-spacing: -0.055em;
		line-height: 1.1;
		word-break: keep-all;
	}

	.story-body {
		align-self: end;
	}

	.story-body > p {
		margin: 0;
		color: var(--color-text-soft);
		font-size: 1.05rem;
		line-height: 1.9;
		word-break: keep-all;
	}

	.experience-path,
	.keywords {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: var(--space-2);
		margin-top: var(--space-6);
	}

	.experience-path span,
	.keywords span {
		border: var(--border-default);
		border-radius: var(--radius-pill);
		padding: var(--space-2) var(--space-3);
		background: color-mix(in srgb, var(--color-surface) 75%, transparent);
		color: var(--color-text);
		font-size: var(--text-xs);
		font-weight: 800;
	}

	.experience-path i {
		color: var(--color-text-faint);
		font-style: normal;
	}

	.capabilities {
		padding-top: clamp(var(--space-10), 7vw, var(--space-16));
	}

	.care-grid {
		display: grid;
		grid-template-columns: repeat(4, minmax(0, 1fr));
		gap: var(--space-4);
		margin-top: var(--space-10);
	}

	.care-card {
		display: flex;
		min-height: 20rem;
		flex-direction: column;
		border: var(--border-default);
		border-top: 3px solid #aebea8;
		padding: var(--space-6);
		background: color-mix(in srgb, var(--color-surface) 72%, transparent);
	}

	.care-card__index {
		margin: 0 0 auto;
		color: var(--color-text-faint);
		font-family: var(--font-mono);
		font-size: var(--text-xs);
	}

	.care-card h3 {
		margin: var(--space-10) 0 0;
		font-size: 1.05rem;
	}

	.care-card > p:last-child {
		margin: var(--space-3) 0 0;
		color: var(--color-text-soft);
		line-height: var(--leading-body);
	}

	.explore-links {
		display: flex;
		flex-wrap: wrap;
		justify-content: flex-start;
		gap: var(--space-3);
		margin-top: var(--space-8);
	}

	.explore-links a {
		display: inline-flex;
		gap: var(--space-5);
		border: var(--border-default);
		border-radius: var(--radius-pill);
		padding: var(--space-2) var(--space-4);
		background: var(--color-surface);
		color: var(--color-accent-strong);
		font-size: var(--text-sm);
		font-weight: 850;
		text-decoration: none;
	}

	.featured-grid {
		display: grid;
		grid-template-columns: repeat(3, minmax(0, 1fr));
		gap: var(--space-5);
		margin-top: var(--space-10);
	}

	.section-action,
	.section-with-action > a {
		display: inline-flex;
		min-height: 2.75rem;
		align-items: center;
		color: var(--color-accent-strong);
		font-size: var(--text-sm);
		font-weight: 850;
	}

	.section-action {
		margin-top: var(--space-6);
	}

	.section-with-action {
		display: flex;
		align-items: end;
		justify-content: space-between;
		gap: var(--space-8);
	}

	.closing {
		display: flex;
		margin: clamp(var(--space-20), 12vw, 10rem) calc(50% - 50vw) calc(-1 * var(--space-20));
		align-items: end;
		justify-content: space-between;
		gap: var(--space-10);
		padding: clamp(var(--space-16), 10vw, 8rem) max(var(--gutter), calc((100vw - var(--width-content)) / 2));
		background: #3f4d41;
		color: var(--color-on-accent);
	}

	.closing .question {
		color: var(--color-on-dark-accent);
	}

	.closing h2 {
		max-width: 15ch;
		color: var(--color-on-accent);
	}

	.closing > div:first-child > p:last-child {
		max-width: var(--width-reading);
		margin: var(--space-6) 0 0;
		color: var(--color-on-dark-soft);
		font-size: var(--text-md);
	}

	.contact-links {
		display: flex;
		flex: 0 0 auto;
		flex-wrap: wrap;
		justify-content: flex-end;
		gap: var(--space-2);
	}

	.contact-email {
		display: inline-flex;
		min-height: 2.75rem;
		align-items: center;
		border: 1px solid var(--color-border-strong);
		border-radius: var(--radius-pill);
		padding-inline: var(--space-4);
		background: var(--color-surface);
		color: var(--color-accent-strong);
		font-size: var(--text-sm);
		font-weight: 850;
		text-decoration: none;
	}

	@media (max-width: 1100px) {
		.care-grid,
		.featured-grid {
			grid-template-columns: repeat(2, minmax(0, 1fr));
		}
	}

	@media (max-width: 760px) {
		.hero {
			min-height: auto;
		}

		.hero-meta {
			align-items: center;
			margin-bottom: var(--space-12);
		}

		.hero-meta .eyebrow {
			margin: 0;
		}

		.name {
			font-size: var(--text-sm);
		}

		.hero-copy h1 {
			font-size: clamp(3rem, 13vw, 5.2rem);
		}

		.story-block,
		.care-grid,
		.featured-grid {
			grid-template-columns: 1fr;
		}

		.story-block {
			gap: var(--space-8);
		}

		.care-card {
			min-height: 17rem;
		}

		.section-with-action,
		.closing {
			align-items: flex-start;
			flex-direction: column;
		}

		.contact-links {
			justify-content: flex-start;
		}
	}
</style>
