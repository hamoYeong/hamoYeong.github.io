---
import {
	defaultLocale,
	languageLabels,
	locales,
	localeStorageKey,
	localizedPath,
} from '../i18n/config';

const fallbackPath = localizedPath(defaultLocale);
const redirectScript = `(() => {
	const supportedLocales = ${JSON.stringify(locales)};
	const storageKey = ${JSON.stringify(localeStorageKey)};
	let selectedLocale;

	try {
		const storedLocale = window.localStorage.getItem(storageKey);
		if (supportedLocales.includes(storedLocale)) selectedLocale = storedLocale;
	} catch {}

	if (!selectedLocale) {
		const browserLanguages = navigator.languages?.length
			? navigator.languages
			: [navigator.language];
		selectedLocale = browserLanguages.some((language) =>
			language?.toLowerCase().startsWith('ko')
		)
			? 'ko'
			: 'en';
	}

	window.location.replace('/' + selectedLocale + '/');
})();`;
---

<!doctype html>
<html lang={defaultLocale}>
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width" />
		<meta http-equiv="refresh" content={`2;url=${fallbackPath}`} />
		<title>Language · Hamo</title>
		<script is:inline set:html={redirectScript}></script>
	</head>
	<body>
		<main>
			<p>언어를 선택해 주세요. Choose your language.</p>
			<nav aria-label="Language">
				{
					locales.map((locale) => (
						<a href={localizedPath(locale)} lang={locale}>
							{languageLabels[locale]}
						</a>
					))
				}
			</nav>
		</main>
	</body>
</html>

<style>
	:root {
		font-family:
			"Pretendard", "Apple SD Gothic Neo", "Noto Sans KR", Inter, ui-sans-serif,
			system-ui, sans-serif;
		color: #18191b;
	}

	body {
		display: grid;
		min-height: 100vh;
		margin: 0;
		place-items: center;
	}

	main {
		padding: 2rem;
		text-align: center;
	}

	nav {
		display: flex;
		justify-content: center;
		gap: 0.75rem;
		margin-top: 1.5rem;
	}

	a {
		border: 1px solid #d9dde2;
		border-radius: 0.375rem;
		padding: 0.65rem 1rem;
		color: inherit;
		font-weight: 700;
		text-decoration: none;
	}
</style>
