---
import BaseLayout from '../../layouts/BaseLayout.astro';
import projects from '../../data/projects.json';

const project = projects.find(
	(item) => item.slug === 'table-tennis-club-notion',
);
---

<BaseLayout
	title={`${project?.title ?? 'Project'} | Hamo`}
	description={project?.description ?? 'Hamo의 프로젝트 상세 페이지입니다.'}
>
	<section class="project-detail">
		<a class="back-link" href="/projects/">Projects로 돌아가기</a>
		<h1>{project?.title}</h1>
		<p class="summary">{project?.description}</p>

		<div class="meta-list" aria-label="Project information">
			<div>
				<h2>내가 한 일</h2>
				<p>{project?.role}</p>
			</div>
			<div>
				<h2>사용 도구</h2>
				<p>{project?.tools.join(', ')}</p>
			</div>
			<div>
				<h2>결과</h2>
				<p>{project?.result}</p>
			</div>
		</div>

		<section class="detail-section" aria-labelledby="detail-title">
			<h2 id="detail-title">프로젝트 배경과 배운 점</h2>
			<p>{project?.detail}</p>
		</section>
	</section>
</BaseLayout>

<style>
	.project-detail {
		max-width: 46rem;
	}

	.back-link {
		display: inline-block;
		margin-bottom: 1.5rem;
		color: #294e75;
		font-weight: 700;
		text-decoration: underline;
		text-underline-offset: 0.25em;
	}

	h1 {
		margin: 0;
		font-size: clamp(2.5rem, 7vw, 4.5rem);
		line-height: 1.08;
		word-break: keep-all;
	}

	.summary,
	.detail-section p,
	.meta-list p {
		color: #4b535c;
		line-height: 1.8;
		word-break: keep-all;
	}

	.summary {
		margin: 1.25rem 0 0;
		font-size: 1.1rem;
	}

	.meta-list {
		display: grid;
		grid-template-columns: repeat(3, minmax(0, 1fr));
		gap: 1rem;
		margin-top: clamp(3rem, 7vw, 5rem);
		border-top: 1px solid #e6e8eb;
		padding-top: 1.75rem;
	}

	h2 {
		margin: 0;
		font-size: 1.05rem;
		line-height: 1.4;
	}

	.meta-list p {
		margin: 0.75rem 0 0;
	}

	.detail-section {
		margin-top: clamp(3rem, 7vw, 5rem);
		border-top: 1px solid #e6e8eb;
		padding-top: 1.75rem;
	}

	.detail-section p {
		margin: 1rem 0 0;
	}

	@media (max-width: 640px) {
		.meta-list {
			grid-template-columns: 1fr;
			gap: 1.25rem;
		}
	}
</style>
