---
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import '../styles/global.css';
import {
	defaultLocale,
	type Locale,
	type LocalePaths,
} from '../i18n/config';
import { getUi } from '../i18n/ui';

interface Props {
	title?: string;
	description?: string;
	locale?: Locale;
	alternatePaths?: Partial<LocalePaths>;
	noindex?: boolean;
}

const {
	locale = defaultLocale,
	alternatePaths,
	noindex = false,
} = Astro.props;
const t = getUi(locale);
const title = Astro.props.title ?? t.site.defaultTitle;
const description = Astro.props.description ?? t.site.defaultDescription;
---

<html lang={locale}>
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="viewport" content="width=device-width" />
		<meta name="generator" content={Astro.generator} />
		<meta name="description" content={description} />
		{noindex && <meta name="robots" content="noindex, nofollow" />}
		<title>{title}</title>
	</head>
	<body>
		<a class="skip-link" href="#main-content">{t.site.skipLink}</a>
		<Header
			locale={locale}
			currentPath={Astro.url.pathname}
			alternatePaths={alternatePaths}
		/>

		<main id="main-content" class="site-main">
			<slot />
		</main>

		<Footer locale={locale} />
	</body>
</html>
