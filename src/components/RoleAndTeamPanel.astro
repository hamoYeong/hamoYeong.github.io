---
import Callout from './Callout.astro';

interface Props {
	teamTitle: string;
	teamDescription: string;
	roleTitle: string;
	roles: string[];
	contributionTitle: string;
	contributions: string[];
}

const {
	teamTitle,
	teamDescription,
	roleTitle,
	roles,
	contributionTitle,
	contributions,
} = Astro.props;
---

<Callout title={teamTitle}>
	<p>{teamDescription}</p>
</Callout>
<div class="role-grid">
	<div>
		<h3>{roleTitle}</h3>
		<ul>{roles.map((item) => <li>{item}</li>)}</ul>
	</div>
	<div>
		<h3>{contributionTitle}</h3>
		<ul>{contributions.map((item) => <li>{item}</li>)}</ul>
	</div>
</div>

<style>
	.role-grid {
		display: grid;
		margin-top: var(--space-8);
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: var(--space-8);
	}

	.role-grid > div {
		border-left: 3px solid var(--color-border);
		padding-left: var(--space-5);
	}

	.role-grid h3 {
		margin: 0;
		font-size: var(--text-md);
	}

	.role-grid ul {
		display: grid;
		gap: var(--space-3);
		margin: var(--space-6) 0 0;
		padding-left: var(--space-5);
	}

	.role-grid li {
		color: var(--color-text-soft);
		line-height: var(--leading-body);
	}

	@media (max-width: 820px) {
		.role-grid {
			grid-template-columns: 1fr;
		}
	}
</style>
