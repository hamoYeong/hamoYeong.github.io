---
import type { EvidenceLevel } from '../i18n/taxonomy';

interface Props {
	level: EvidenceLevel;
	label: string;
	description?: string;
}

const { level, label, description } = Astro.props;
---

<span class="evidence-badge" data-level={level} title={description}>{label}</span>

<style>
	.evidence-badge {
		display: inline-flex;
		min-height: 1.75rem;
		align-items: center;
		border: 1px solid color-mix(in srgb, var(--color-accent) 36%, var(--color-border));
		border-radius: var(--radius-pill);
		padding: 0.15rem var(--space-3);
		background: var(--color-surface);
		color: var(--color-accent-strong);
		font-family: var(--font-mono);
		font-size: var(--text-xs);
		font-weight: 850;
		line-height: 1.3;
	}

	.evidence-badge[data-level='hypothesis'] {
		border-style: dashed;
		color: var(--color-text-soft);
	}

	.evidence-badge[data-level='measured'],
	.evidence-badge[data-level='operated'] {
		background: var(--color-surface-accent);
	}
</style>
