---
import type { EvidenceLevel } from '../i18n/taxonomy';
import type { PortfolioAsset, PortfolioBlock } from '../lib/portfolio';
import EvidenceLevelBadge from './EvidenceLevelBadge.astro';
import Tag from './Tag.astro';

interface LabelItem {
	key: string;
	label: string;
	description?: string;
}

interface Props {
	block: PortfolioBlock;
	assets: PortfolioAsset[];
	pageNumber: number;
	pageCount: number;
	sourceLabel: string;
	kindLabel: string;
	roleLabels: LabelItem[];
	competencyLabels: LabelItem[];
	evidenceLabels: LabelItem[];
	bridge?: {
		direction: 'earlier' | 'later' | 'same' | 'reflection';
		label: string;
		text: string;
	};
	dynamicBridge?: boolean;
	initiallyHidden?: boolean;
	labels: {
		page: string;
		evidence: string;
		copy: string;
		copied: string;
		openSource: string;
		webAsset: string;
		masterAsset: string;
	};
}

const {
	block,
	assets,
	pageNumber,
	pageCount,
	sourceLabel,
	kindLabel,
	roleLabels,
	competencyLabels,
	evidenceLabels,
	bridge,
	dynamicBridge = false,
	initiallyHidden = false,
	labels,
} = Astro.props;
const copyValue = Array.isArray(block.text) ? block.text.join('\n') : block.text;
const textPreview = Array.isArray(block.text) ? block.text[0] : block.text;
---

<article
	class="story-page"
	data-story-page
	data-block-id={block.id}
	data-role={block.roleLenses.join('|')}
	data-competency={block.competencies.join('|')}
	data-evidence={block.evidenceLevels.join('|')}
	data-source-type={block.sourceType}
	data-source-key={block.sourceKey}
	data-source-title={block.sourceTitle}
	data-block-title={block.title}
	data-text-preview={textPreview}
	data-date={block.date}
	data-priority={block.priority}
	data-kind={block.kind}
	hidden={initiallyHidden}
>
	{
		(bridge || dynamicBridge) && (
			<aside
				class:list={['story-bridge', bridge && `story-bridge--${bridge.direction}`]}
				data-story-bridge={dynamicBridge ? '' : undefined}
				hidden={dynamicBridge}
			>
				<p data-bridge-label>{bridge?.label}</p>
				<p data-bridge-text>{bridge?.text}</p>
			</aside>
		)
	}

	<header class="story-page__header">
		<div class="story-page__meta">
			<span><span data-page-number>{String(pageNumber).padStart(2, '0')}</span> / <span data-page-count>{String(pageCount).padStart(2, '0')}</span> {labels.page}</span>
			<span>{sourceLabel} · {kindLabel}</span>
		</div>
		<h2 tabindex="-1">{block.title}</h2>
		<p>{block.sourceTitle}</p>
	</header>

	<div class="story-page__copy" data-block-copy>
		{
			Array.isArray(block.text) ? (
				<ul>{block.text.map((item) => <li>{item}</li>)}</ul>
			) : (
				<p>{block.text}</p>
			)
		}
	</div>

	{
		assets.length > 0 && (
			<div class="story-page__assets">
				{assets.map((asset) => (
					<figure>
						{asset.type === 'image' && asset.webSrc && (
							<img src={asset.webSrc} alt={asset.alt ?? ''} loading="lazy" />
						)}
						<figcaption>
							{asset.caption && <p>{asset.caption}</p>}
							{asset.webSrc && <p><strong>{labels.webAsset}</strong> <code>{asset.webSrc}</code></p>}
							{asset.masterPath && <p><strong>{labels.masterAsset}</strong> <code>{asset.masterPath}</code></p>}
						</figcaption>
					</figure>
				))}
			</div>
		)
	}

	<details class="story-page__evidence">
		<summary>{labels.evidence}</summary>
		<div>
			{roleLabels.map((item) => <Tag label={item.label} />)}
		</div>
		<div>
			{competencyLabels.map((item) => <Tag label={item.label} />)}
		</div>
		<div>
			{evidenceLabels.map((item) => (
				<EvidenceLevelBadge
					level={item.key as EvidenceLevel}
					label={item.label}
					description={item.description}
				/>
			))}
		</div>
	</details>

	<footer class="story-page__actions">
		<button
			type="button"
			data-copy
			data-copy-value={copyValue}
			data-copy-label={labels.copy}
			data-copied-label={labels.copied}
		>
			{labels.copy}
		</button>
		<a href={block.href}>{labels.openSource} →</a>
	</footer>
</article>

<style>
	.story-page {
		min-height: 35rem;
		border: var(--border-default);
		border-radius: var(--radius-lg);
		padding: clamp(var(--space-5), 4vw, var(--space-10));
		background: var(--color-surface);
		box-shadow: var(--shadow-card);
	}

	.story-page[hidden] {
		display: none;
	}

	.story-bridge {
		margin-bottom: var(--space-8);
		border-left: 4px solid var(--color-accent);
		padding: var(--space-4) var(--space-5);
		background: var(--color-surface-accent);
	}

	.story-bridge p {
		margin: 0;
	}

	.story-bridge p:first-child {
		color: var(--color-accent-strong);
		font-family: var(--font-mono);
		font-size: var(--text-xs);
		font-weight: 900;
		letter-spacing: 0.05em;
		text-transform: uppercase;
	}

	.story-bridge p + p {
		margin-top: var(--space-2);
		color: var(--color-text-soft);
		line-height: 1.75;
	}

	.story-bridge--earlier {
		border-left-color: var(--color-text-faint);
	}

	.story-bridge--reflection {
		border-left-color: var(--color-warning, #9b6a2f);
	}

	.story-page__meta {
		display: flex;
		flex-wrap: wrap;
		justify-content: space-between;
		gap: var(--space-3);
		color: var(--color-accent-strong);
		font-family: var(--font-mono);
		font-size: var(--text-xs);
		font-weight: 850;
	}

	.story-page__header h2 {
		max-width: 24ch;
		margin: var(--space-5) 0 0;
		font-size: clamp(1.9rem, 4vw, 3.25rem);
		letter-spacing: -0.04em;
		line-height: 1.12;
		word-break: keep-all;
	}

	.story-page__header > p {
		margin: var(--space-3) 0 0;
		color: var(--color-text-faint);
		font-size: var(--text-sm);
		font-weight: 750;
	}

	.story-page__copy {
		max-width: var(--width-reading);
		margin-top: var(--space-8);
		font-size: clamp(1rem, 2vw, 1.12rem);
		line-height: 1.85;
	}

	.story-page__copy p,
	.story-page__copy ul {
		margin: 0;
	}

	.story-page__copy ul {
		display: grid;
		gap: var(--space-3);
		padding-left: var(--space-6);
	}

	.story-page__assets {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: var(--space-4);
		margin-top: var(--space-8);
	}

	.story-page__assets figure {
		min-width: 0;
		margin: 0;
		border: var(--border-default);
		border-radius: var(--radius-md);
		padding: var(--space-4);
		background: var(--color-surface-muted);
	}

	.story-page__assets img {
		width: 100%;
		max-height: 24rem;
		object-fit: contain;
		background: var(--color-canvas);
	}

	.story-page__assets figcaption {
		margin-top: var(--space-3);
		color: var(--color-text-soft);
		font-size: var(--text-xs);
		line-height: 1.6;
	}

	.story-page__assets figcaption p {
		margin: var(--space-2) 0 0;
	}

	.story-page__assets code {
		word-break: break-all;
	}

	.story-page__evidence {
		max-width: var(--width-reading);
		margin-top: var(--space-8);
		border-top: var(--border-default);
		padding-top: var(--space-5);
	}

	.story-page__evidence summary {
		color: var(--color-accent-strong);
		font-size: var(--text-sm);
		font-weight: 850;
		cursor: pointer;
	}

	.story-page__evidence > div {
		display: flex;
		flex-wrap: wrap;
		gap: var(--space-2);
		margin-top: var(--space-3);
	}

	.story-page__actions {
		display: flex;
		flex-wrap: wrap;
		gap: var(--space-3);
		margin-top: var(--space-8);
	}

	.story-page__actions a,
	.story-page__actions button {
		display: inline-flex;
		min-height: 2.75rem;
		align-items: center;
		border: var(--border-default);
		border-radius: var(--radius-pill);
		padding: 0 var(--space-4);
		background: var(--color-surface);
		color: var(--color-accent-strong);
		font: inherit;
		font-size: var(--text-sm);
		font-weight: 850;
		text-decoration: none;
		cursor: pointer;
	}

	.story-page.is-entering-forward {
		animation: story-enter-forward 300ms ease-out;
	}

	.story-page.is-entering-backward {
		animation: story-enter-backward 300ms ease-out;
	}

	@keyframes story-enter-forward {
		from { opacity: 0; transform: translateX(2rem); }
		to { opacity: 1; transform: translateX(0); }
	}

	@keyframes story-enter-backward {
		from { opacity: 0; transform: translateX(-2rem); }
		to { opacity: 1; transform: translateX(0); }
	}

	@media (max-width: 680px) {
		.story-page {
			min-height: 31rem;
		}

		.story-page__assets {
			grid-template-columns: 1fr;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.story-page.is-entering-forward,
		.story-page.is-entering-backward {
			animation: none;
		}
	}

	@media print {
		.story-page {
			display: block !important;
			min-height: 0;
			break-inside: avoid;
			box-shadow: none;
		}
	}
</style>
