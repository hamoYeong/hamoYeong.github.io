---
import Tag from './Tag.astro';

interface RelatedItem {
	type: string;
	title: string;
	description: string;
	href?: string;
	meta?: string;
	tags?: string[];
}

interface Props {
	title: string;
	items: RelatedItem[];
	openLabel: string;
}

const { title, items, openLabel } = Astro.props;
---

{
	items.length > 0 && (
		<section class="related-content" id="related-content" aria-labelledby="related-content-title">
			<h2 id="related-content-title">{title}</h2>
			<div class="related-content__grid">
				{items.map((item) => (
					<article>
						<p class="related-content__type">{item.type}</p>
						<h3>{item.title}</h3>
						{item.meta && <p class="related-content__meta">{item.meta}</p>}
						<p>{item.description}</p>
						{item.tags && item.tags.length > 0 && (
							<div class="related-content__tags">
								{item.tags.map((tag) => <Tag label={tag} />)}
							</div>
						)}
						{item.href && <a href={item.href}>{openLabel} →</a>}
					</article>
				))}
			</div>
		</section>
	)
}

<style>
	.related-content {
		margin-top: var(--space-8);
		border-top: var(--border-default);
		padding-top: var(--space-12);
	}

	.related-content h2 {
		margin: 0;
		font-size: var(--text-xl);
	}

	.related-content__grid {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: var(--space-4);
		margin-top: var(--space-6);
	}

	.related-content article {
		border: var(--border-default);
		border-radius: var(--radius-md);
		padding: var(--space-5);
		background: var(--color-surface);
	}

	.related-content__type {
		margin: 0;
		color: var(--color-accent-strong);
		font-family: var(--font-mono);
		font-size: var(--text-xs);
		font-weight: 850;
	}

	.related-content h3 {
		margin: var(--space-2) 0 0;
		font-size: 1.08rem;
	}

	.related-content article > p:not(.related-content__type) {
		margin: var(--space-3) 0 0;
		color: var(--color-text-soft);
		line-height: var(--leading-body);
	}

	.related-content article > .related-content__meta {
		color: var(--color-text-faint);
		font-size: var(--text-sm);
	}

	.related-content__tags {
		display: flex;
		flex-wrap: wrap;
		gap: var(--space-2);
		margin-top: var(--space-4);
	}

	.related-content a {
		display: inline-flex;
		min-height: 2.75rem;
		margin-top: var(--space-4);
		align-items: center;
		color: var(--color-accent-strong);
		font-size: var(--text-sm);
		font-weight: 850;
	}

	@media (max-width: 720px) {
		.related-content__grid {
			grid-template-columns: 1fr;
		}
	}
</style>
