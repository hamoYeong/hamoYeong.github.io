---
import Tag from './Tag.astro';

interface ProjectFact {
	label: string;
	value: string;
}

interface ProjectImage {
	src: string;
	alt: string;
}

interface Props {
	title: string;
	summary?: string;
	description?: string;
	href?: string;
	slug?: string;
	meta?: string;
	tags?: string[];
	tools?: string[];
	facts?: ProjectFact[];
	actionLabel?: string;
	image?: ProjectImage;
}

const {
	title,
	summary,
	description,
	href,
	slug,
	meta,
	tags,
	tools,
	facts = [],
	actionLabel,
	image,
} = Astro.props;
const projectUrl = href ?? `/projects/${slug}/`;
const projectSummary = summary ?? description ?? '';
const projectTags = tags ?? tools ?? [];
const fallbackMark = title.trim().slice(0, 1).toUpperCase();
---

<article class="project-card">
	<div class="project-card__visual" aria-hidden={image ? undefined : 'true'}>
		{
			image ? (
				<img src={image.src} alt={image.alt} loading="lazy" />
			) : (
				<span>{fallbackMark}</span>
			)
		}
	</div>
	<div class="project-card__body">
		{meta && <p class="project-card__meta">{meta}</p>}
		<h2><a href={projectUrl}>{title}</a></h2>
		<p class="project-card__description">{projectSummary}</p>
		{
			facts.length > 0 && (
				<dl class="project-card__facts">
					{facts.map((fact) => (
						<div>
							<dt>{fact.label}</dt>
							<dd>{fact.value}</dd>
						</div>
					))}
				</dl>
			)
		}
		{
			projectTags.length > 0 && (
				<div class="project-card__tags">
					{projectTags.map((tag) => <Tag label={tag} />)}
				</div>
			)
		}
		{
			actionLabel && (
				<a class="project-card__action" href={projectUrl}>
					{actionLabel} <span aria-hidden="true">→</span>
				</a>
			)
		}
	</div>
</article>

<style>
	.project-card {
		overflow: hidden;
		border: var(--border-default);
		border-radius: var(--radius-lg);
		background: var(--color-surface);
		box-shadow: var(--shadow-card);
	}

	.project-card__visual {
		position: relative;
		display: grid;
		min-height: 10rem;
		overflow: hidden;
		place-items: center;
		background:
			radial-gradient(circle at 78% 22%, rgb(255 255 255 / 0.65) 0 10%, transparent 11%),
			linear-gradient(135deg, var(--color-surface-accent), var(--color-surface-muted));
		color: var(--color-accent-strong);
		text-decoration: none;
	}

	.project-card__visual::before,
	.project-card__visual::after {
		position: absolute;
		width: 7rem;
		height: 7rem;
		border: 1px solid color-mix(in srgb, var(--color-accent) 30%, transparent);
		border-radius: 50%;
		content: '';
	}

	.project-card__visual::before {
		top: -2.5rem;
		left: -1.5rem;
	}

	.project-card__visual::after {
		right: -2rem;
		bottom: -3rem;
	}

	.project-card__visual span {
		font-family: var(--font-mono);
		font-size: 2rem;
		font-weight: 900;
	}

	.project-card__visual img {
		width: 100%;
		height: 12rem;
		object-fit: cover;
		object-position: top;
	}

	.project-card__body {
		padding: var(--space-6);
	}

	.project-card__meta {
		margin: 0;
		color: var(--color-text-faint);
		font-size: var(--text-sm);
	}

	h2 {
		margin: var(--space-2) 0 0;
		font-size: var(--text-lg);
		letter-spacing: -0.015em;
		word-break: keep-all;
	}

	h2 a {
		color: var(--color-text);
		text-decoration: none;
	}

	h2 a:hover {
		color: var(--color-accent-strong);
		text-decoration: underline;
	}

	.project-card__description {
		margin: var(--space-3) 0 0;
		color: var(--color-text-soft);
		line-height: var(--leading-body);
	}

	.project-card__facts {
		display: grid;
		gap: var(--space-4);
		margin: var(--space-5) 0 0;
		border-top: var(--border-default);
		padding-top: var(--space-5);
	}

	.project-card__facts div {
		display: grid;
		grid-template-columns: 4.5rem 1fr;
		gap: var(--space-3);
	}

	.project-card__facts dt {
		color: var(--color-accent-strong);
		font-size: var(--text-xs);
		font-weight: 900;
		letter-spacing: 0.04em;
		text-transform: uppercase;
	}

	.project-card__facts dd {
		margin: 0;
		color: var(--color-text-soft);
		font-size: var(--text-sm);
		line-height: 1.6;
	}

	.project-card__tags {
		display: flex;
		flex-wrap: wrap;
		gap: var(--space-2);
		margin-top: var(--space-5);
	}

	.project-card__action {
		display: inline-flex;
		min-height: 2.75rem;
		margin-top: var(--space-5);
		align-items: center;
		gap: var(--space-2);
		color: var(--color-accent-strong);
		font-size: var(--text-sm);
		font-weight: 850;
	}
</style>
