---
import Tag from './Tag.astro';

interface ProjectFact {
	label: string;
	value: string;
}

interface ProjectImage {
	src: string;
	alt: string;
}

interface Props {
	title: string;
	headingLevel?: 'h2' | 'h3';
	summary?: string;
	summaryNote?: string;
	description?: string;
	href?: string;
	slug?: string;
	meta?: string;
	tags?: string[];
	tools?: string[];
	facts?: ProjectFact[];
	actionLabel?: string;
	image?: ProjectImage;
	variant?: 'featured' | 'compact';
}

const {
	title,
	headingLevel = 'h2',
	summary,
	summaryNote,
	description,
	href,
	slug,
	meta,
	tags,
	tools,
	facts = [],
	actionLabel,
	image,
	variant = 'featured',
} = Astro.props;
const projectUrl = href ?? `/projects/${slug}/`;
const projectSummary = summary ?? description ?? '';
const projectTags = tags ?? tools ?? [];
const Heading = headingLevel;
---

<article class:list={['project-card', `project-card--${variant}`]}>
	{image && (
		<a class="project-card__visual" href={projectUrl}>
			<img src={image.src} alt={image.alt} loading="lazy" />
		</a>
	)}
	<div class="project-card__body">
		{meta && <p class="project-card__meta">{meta}</p>}
		<Heading class="project-card__title"><a href={projectUrl}>{title}</a></Heading>
		<p class="project-card__description">{projectSummary}</p>
		{summaryNote && <p class="project-card__note">{summaryNote}</p>}
		{
			facts.length > 0 && (
				<dl class="project-card__facts">
					{facts.map((fact) => (
						<div>
							<dt>{fact.label}</dt>
							<dd>{fact.value}</dd>
						</div>
					))}
				</dl>
			)
		}
		{
			projectTags.length > 0 && (
				<div class="project-card__tags">
					{projectTags.map((tag) => <Tag label={tag} />)}
				</div>
			)
		}
		{
			actionLabel && (
				<a class="project-card__action" href={projectUrl}>
					{actionLabel} <span aria-hidden="true">→</span>
				</a>
			)
		}
	</div>
</article>

<style>
	.project-card {
		overflow: hidden;
		border: var(--border-default);
		border-radius: var(--radius-lg);
		background: var(--color-surface);
		box-shadow: var(--shadow-card);
	}

	.project-card__visual {
		display: block;
		overflow: hidden;
		text-decoration: none;
	}

	.project-card__visual img {
		width: 100%;
		height: 12rem;
		object-fit: cover;
		object-position: top;
	}

	.project-card__body {
		padding: var(--space-6);
	}

	.project-card__meta {
		margin: 0;
		color: var(--color-text-faint);
		font-size: var(--text-sm);
	}

	.project-card__title {
		margin: var(--space-2) 0 0;
		font-size: var(--text-lg);
		letter-spacing: -0.015em;
		word-break: keep-all;
	}

	.project-card__title a {
		color: var(--color-text);
		text-decoration: none;
	}

	.project-card__title a:hover {
		color: var(--color-accent-strong);
		text-decoration: underline;
	}

	.project-card__description {
		margin: var(--space-3) 0 0;
		color: var(--color-text-soft);
		line-height: var(--leading-body);
	}

	.project-card__note {
		margin: var(--space-2) 0 0;
		color: var(--color-text-faint);
		font-size: var(--text-sm);
		line-height: 1.6;
	}

	.project-card__facts {
		display: grid;
		gap: var(--space-4);
		margin: var(--space-5) 0 0;
		border-top: var(--border-default);
		padding-top: var(--space-5);
	}

	.project-card__facts div {
		display: grid;
		grid-template-columns: 4.5rem 1fr;
		gap: var(--space-3);
	}

	.project-card__facts dt {
		color: var(--color-accent-strong);
		font-size: var(--text-xs);
		font-weight: 900;
		letter-spacing: 0.04em;
		text-transform: uppercase;
	}

	.project-card__facts dd {
		margin: 0;
		color: var(--color-text-soft);
		font-size: var(--text-sm);
		line-height: 1.6;
	}

	.project-card__tags {
		display: flex;
		flex-wrap: wrap;
		gap: var(--space-2);
		margin-top: var(--space-5);
	}

	.project-card__action {
		display: inline-flex;
		min-height: 2.75rem;
		margin-top: var(--space-5);
		align-items: center;
		gap: var(--space-2);
		color: var(--color-accent-strong);
		font-size: var(--text-sm);
		font-weight: 850;
	}

	.project-card--compact .project-card__body {
		padding: var(--space-5);
	}

	.project-card--compact .project-card__description {
		font-size: 0.96rem;
	}

	.project-card--compact .project-card__facts {
		grid-template-columns: repeat(2, minmax(0, 1fr));
	}

	.project-card--compact .project-card__facts div {
		display: block;
	}

	.project-card--compact .project-card__facts dd {
		margin-top: var(--space-2);
	}

	@media (max-width: 640px) {
		.project-card--compact .project-card__facts {
			grid-template-columns: 1fr;
		}
	}
</style>
