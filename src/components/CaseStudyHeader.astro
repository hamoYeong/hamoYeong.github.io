---
import ExternalLink from './ExternalLink.astro';
import Tag from './Tag.astro';

interface Props {
	eyebrow: string;
	status: string;
	title: string;
	summary: string;
	summaryNote?: string;
	categories: string[];
	coverImage?: { src: string; alt: string };
	technologies: string[];
	periodLabel: string;
	periodTitle: string;
	role: string[];
	roleTitle: string;
	technologyTitle: string;
	repository?: string;
	repositoryLabel: string;
	demo?: string;
	demoLabel: string;
}

const {
	eyebrow,
	status,
	title,
	summary,
	summaryNote,
	categories,
	coverImage,
	technologies,
	periodLabel,
	periodTitle,
	role,
	roleTitle,
	technologyTitle,
	repository,
	repositoryLabel,
	demo,
	demoLabel,
} = Astro.props;
---

<header class="case-header">
	<div class="case-hero">
		<div class="case-hero__content">
			<div class="case-hero__eyebrow">
				<p class="eyebrow">{eyebrow}</p>
				<span>{status}</span>
			</div>
			<h1>{title}</h1>
			<p class="case-hero__summary">{summary}</p>
			{summaryNote && <p class="case-hero__summary-note">{summaryNote}</p>}
			<div class="case-hero__tags">
				{categories.map((category) => <Tag label={category} />)}
			</div>
		</div>
		<div
			class:list={['case-hero__visual', { 'case-hero__visual--image': coverImage }]}
			aria-hidden={coverImage ? undefined : 'true'}
		>
			{coverImage ? (
				<img src={coverImage.src} alt={coverImage.alt} />
			) : (
				<>
					<span>{title.trim().slice(0, 1).toUpperCase()}</span>
					<p>{technologies.slice(0, 3).join(' · ')}</p>
				</>
			)}
		</div>
	</div>

	<dl class="project-meta">
		<div>
			<dt>{periodTitle}</dt>
			<dd>{periodLabel}</dd>
		</div>
		<div>
			<dt>{roleTitle}</dt>
			<dd>{role.join(', ')}</dd>
		</div>
		<div>
			<dt>{technologyTitle}</dt>
			<dd>{technologies.join(', ')}</dd>
		</div>
	</dl>

	{(repository || demo) && (
		<div class="external-links">
			{repository && <ExternalLink href={repository}>{repositoryLabel}</ExternalLink>}
			{demo && <ExternalLink href={demo}>{demoLabel}</ExternalLink>}
		</div>
	)}
</header>

<style>
	.case-hero {
		display: grid;
		margin-top: var(--space-8);
		grid-template-columns: minmax(0, 1.4fr) minmax(15rem, 0.6fr);
		gap: clamp(var(--space-8), 7vw, var(--space-16));
		align-items: stretch;
	}

	.case-hero__content {
		padding-block: var(--space-8);
	}

	.case-hero__eyebrow {
		display: flex;
		align-items: center;
		gap: var(--space-3);
	}

	.case-hero__eyebrow p {
		margin: 0;
	}

	.case-hero__eyebrow span {
		border: var(--border-default);
		border-radius: var(--radius-pill);
		padding: 0.2rem var(--space-3);
		color: var(--color-text-soft);
		font-size: var(--text-xs);
		font-weight: 800;
	}

	.case-hero h1 {
		max-width: 16ch;
		margin: var(--space-5) 0 0;
		font-size: clamp(2.8rem, 7vw, 5.75rem);
		line-height: var(--leading-tight);
		letter-spacing: -0.045em;
		word-break: keep-all;
	}

	.case-hero__summary {
		max-width: var(--width-reading);
		margin: var(--space-6) 0 0;
		color: var(--color-text-soft);
		font-size: var(--text-md);
		line-height: var(--leading-body);
	}

	.case-hero__summary-note {
		max-width: var(--width-reading);
		margin: var(--space-3) 0 0;
		color: var(--color-text-faint);
		font-size: var(--text-sm);
		line-height: 1.65;
	}

	.case-hero__tags,
	.external-links {
		display: flex;
		flex-wrap: wrap;
		gap: var(--space-2);
	}

	.case-hero__tags {
		margin-top: var(--space-6);
	}

	.case-hero__visual {
		display: grid;
		min-height: 22rem;
		overflow: hidden;
		place-items: center;
		border-radius: var(--radius-lg);
		background:
			radial-gradient(circle at 74% 24%, rgb(255 255 255 / 0.7) 0 9%, transparent 10%),
			linear-gradient(145deg, var(--color-surface-accent), var(--color-surface-muted));
		color: var(--color-accent-strong);
	}

	.case-hero__visual > span {
		font-family: var(--font-mono);
		font-size: 4rem;
		font-weight: 900;
	}

	.case-hero__visual > p {
		align-self: end;
		margin: 0;
		padding: var(--space-5);
		color: var(--color-text-soft);
		font-size: var(--text-xs);
		font-weight: 800;
	}

	.case-hero__visual--image {
		align-items: start;
		background: var(--color-surface-muted);
	}

	.case-hero__visual--image img {
		width: 100%;
		height: 100%;
		max-height: 34rem;
		object-fit: cover;
		object-position: top;
	}

	.project-meta {
		display: grid;
		margin: var(--space-8) 0 0;
		border-block: var(--border-default);
		grid-template-columns: repeat(3, minmax(0, 1fr));
	}

	.project-meta div {
		padding: var(--space-5);
	}

	.project-meta div + div {
		border-left: var(--border-default);
	}

	.project-meta dt {
		color: var(--color-text-faint);
		font-size: var(--text-xs);
		font-weight: 900;
		letter-spacing: 0.06em;
		text-transform: uppercase;
	}

	.project-meta dd {
		margin: var(--space-2) 0 0;
		color: var(--color-text);
		font-size: var(--text-sm);
		line-height: 1.6;
	}

	.external-links {
		margin-top: var(--space-5);
	}

	@media (max-width: 820px) {
		.case-hero {
			grid-template-columns: 1fr;
		}

		.case-hero__visual {
			min-height: 14rem;
		}

		.project-meta {
			grid-template-columns: 1fr;
		}

		.project-meta div + div {
			border-top: var(--border-default);
			border-left: 0;
		}
	}
</style>
